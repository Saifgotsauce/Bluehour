---
// /festival: landing page for S2 "Festival / weekend traveller" (docs/MARKETING-FUNNEL.md).
// Multi-day festivals, travels for shows. The job: get through day 3. Best sold as a crew kit (2–3 rolls).
// Copy rules (docs/CLAIMS.md): no alcohol, hangover, cure or detox words. Structure/function claims only, with an asterisk.
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Promo from '../components/Promo.astro';
import Foot from '../components/Foot.astro';
import Offer from '../components/Offer.astro';
import { TIERS, PRICE, PACKS, mixParam, perNight } from '../data/ingredients.js';
import { PREORDER, SHIP_BY, FOUNDING_CAP } from '../data/preorder.js';
const CREW = TIERS[2];
const DUO = TIERS[1];
const LW = PACKS.find((p) => p.id === 'long-weekend');
const SIG = PACKS.find((p) => p.id === 'signature');
const packing = [
  ['Tickets, ID, charger', 'You know the drill.'],
  ['Earplugs and a refillable bottle', 'Most festivals have free water stations. Use them all day.'],
  ['One Blue Hour pouch per night', 'Tear three off the roll for a three-day weekend. They lie flat in a bum bag or a phone case.'],
  ['Real food', 'Eat a proper meal before the headliner, not just after.'],
];
const faqs = [
  ['Can I bring the pouches into a festival?', 'Every festival sets its own rules, so check the event\'s FAQ before you go. Each pouch is a sealed, labeled dietary supplement, and you can keep the pamphlet with you.'],
  ['How do I split a crew kit?', `Order 3 rolls together at $${CREW.each} each, one checkout, and hand a roll to each friend. That's 30 pouches each.`],
  ['When do I take it?', 'At the end of each day, back at the tent or the Airbnb, with a snack and a big glass of water. One pouch a day, never more.'],
  ['Will it keep me up?', 'No. There is no caffeine and no stimulants in any Blue Hour capsule.'],
  ['Is it right for me?', 'For adults 18 and over. If you are pregnant, nursing, taking medication, have a medical condition, or are under medical supervision, talk to your doctor first.'],
];
---
<Base
  title="Pack it for day three | Blue Hour festival kit"
  description={`One pouch for every night of the weekend. A crew kit of 3 rolls is $${CREW.each} each${PREORDER ? ` for the first ${FOUNDING_CAP} orders` : ''}. Free US shipping.`}
  image="/images/exploded.webp"
>
  <Promo text="Crew kit: 3 rolls, one checkout, free US shipping." />
  <header class="jhero" data-sec="hero">
    <div class="mesh"><i></i><i></i><i></i></div>
    <div class="grain"></div>
    <Top />
    <div class="in">
      <p class="crumb">Festival season</p>
      <h1>Day one is easy. Pack for day three.</h1>
      <p class="dek">One sealed pouch for every night of the weekend: magnesium, glycine, vitamin C and zinc for the days you're on your feet for twelve hours.* Tear off what you need, leave the rest at home.</p>
      <div class="hrow">
        <a class="btn solid" href="#offer" data-cta="hero">Get the crew kit</a>
        <span class="hp">3 rolls · ${CREW.each} each{PREORDER && <> · ships by {SHIP_BY}</>}</span>
      </div>
    </div>
  </header>

  <section class="sec" data-sec="festival_steps">
    <div class="w col">
      <h2 style="color:var(--deep)">A festival day is a workout nobody calls a workout.</h2>
      <p>Researchers who put activity trackers on regular Glastonbury goers found they averaged about 15,700 steps and 11 km a day, with roughly eleven and a half hours on the move.<sup>1</sup> Then you do it again tomorrow, on less sleep, in a tent.</p>
    </div>
    <div class="w stats">
      <div><b>15,661</b><span>steps a day</span></div>
      <div><b>11 km</b><span>walked and danced a day</span></div>
      <div><b>11.5 h</b><span>on the move</span></div>
    </div>
  </section>

  <section class="sec" data-sec="packing" style="background:#FAFBFF">
    <div class="w col">
      <h2 style="color:var(--deep)">The packing list</h2>
      <ul class="pack-list">
        {packing.map(([b, s]) => <li><b>{b}</b><span>{s}</span></li>)}
      </ul>
      <p class="note">Screenshot it for the group chat.</p>
    </div>
  </section>

  <section class="sec" data-sec="signature">
    <div class="w col">
      <h2 style="color:var(--deep)">Two ways to pack it</h2>
      <div class="two-packs">
        <article><p class="tag">{SIG.tag}</p><b>{SIG.name}</b><span>{SIG.line}</span></article>
        <article><p class="tag">{LW.tag}</p><b>{LW.name}</b><span>{LW.line}</span><a class="txt" href={'/build?mix=' + mixParam(LW.mix)} data-cta="long_weekend_pack">See the Long Weekend pack →</a></article>
      </div>
      <p class="note">Pick one in the box below. Every pouch keeps at least two glycine and stays at or under the daily upper limit for adults.*</p>
    </div>
  </section>

  <section class="sec crewkit" data-sec="crew_kit">
    <div class="w col">
      <h2>Going with friends? Buy it as a crew.</h2>
      <p>Every roll in one cart counts toward the price. Three rolls are ${CREW.each} each instead of ${TIERS[0].each}. Two are ${DUO.each}. One checkout, free shipping, and you hand them out at the campsite.</p>
    </div>
  </section>

  <div class="w col pickrow" data-sec="pack_pick">
    <p class="lbl">Your pouch</p>
    <div class="seg" role="group" aria-label="Choose a pack">
      <button type="button" data-offer-pack="signature" aria-pressed="true">The Signature</button>
      <button type="button" data-offer-pack="long-weekend" aria-pressed="false">Long Weekend</button>
    </div>
  </div>
  <Offer heading={PREORDER ? 'a night for a crew of three at the founding price.' : 'a night for a crew of three.'} pick={3} note="Ordering for yourself? Pick 1 roll above. 30 pouches covers a lot of weekends." buildText="Change what's in it" />

  <section class="sec faq" data-sec="faq">
    <div class="w col">
      <h2 style="font-size:clamp(30px,8vw,52px);margin-bottom:10px">Quick questions</h2>
      {faqs.map(([q, a]) => (
        <details><summary><span class="q">{q}</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>{a}</p></details>
      ))}
    </div>
  </section>

  <section class="w col src">
    <p class="fine">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
    <p class="fine">1. Bradley E, Close L, Whyte I. Music Festivals as a Positive Health Alternative to Couch Fandom. <em>Int J Environ Res Public Health</em>, 2019. <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC6616469/" rel="noopener" target="_blank">Read the study</a></p>
  </section>

  <Foot id="em-festival" />
</Base>

<style>
  .col{max-width:720px;display:flex;flex-direction:column;gap:18px;align-items:flex-start}
  .col>p{font-size:clamp(17px,4.5vw,19px);line-height:1.6}
  .hrow{display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px;margin-top:6px}
  .hp{font-weight:700;font-size:16px}
  sup{font-size:.6em;font-weight:700;color:var(--cobalt)}
  .stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;max-width:880px;padding-top:22px}
  .stats div{background:linear-gradient(160deg,var(--deep),var(--cobalt) 55%,var(--bright));color:var(--white);border-radius:20px;padding:20px 14px;display:flex;flex-direction:column;gap:6px}
  .stats b{font:800 clamp(24px,7.4vw,46px)/1 var(--display);letter-spacing:-.04em}
  .stats span{font-size:clamp(12.5px,3.4vw,15px);line-height:1.3;font-weight:500;opacity:.92}
  .pack-list{list-style:none;margin:0;padding:0;display:grid;gap:10px;width:100%}
  .pack-list li{display:flex;flex-direction:column;gap:2px;padding:14px 16px 14px 48px;position:relative;border-radius:16px;background:var(--white);border:1.5px solid var(--line)}
  .pack-list li::before{content:"";position:absolute;left:16px;top:16px;width:20px;height:20px;border-radius:6px;border:2px solid var(--cobalt)}
  .pack-list b{font:800 17px/1.25 var(--display);color:var(--deep)}
  .pack-list span{font-size:15px;color:var(--soft)}
  .note{font-size:16px;color:var(--soft)}
  .two-packs{display:grid;gap:12px;width:100%}
  .two-packs article{border:2px solid var(--ink);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:6px;background:var(--white)}
  .two-packs .tag{font:700 12px/1 var(--display);letter-spacing:.08em;text-transform:uppercase;color:var(--cobalt)}
  .two-packs b{font:800 21px/1.2 var(--display);color:var(--deep)}
  .two-packs span{font-size:15.5px;color:var(--soft)}
  .txt{font-weight:700;color:var(--cobalt);text-underline-offset:4px}
  .crewkit{background:linear-gradient(160deg,var(--deep),var(--cobalt));color:var(--white)}
  .crewkit h2{color:var(--white)}
  .pickrow{padding-top:clamp(40px,9vw,70px);gap:10px}
  .lbl{font:700 13px/1 var(--display);letter-spacing:.08em;text-transform:uppercase;color:var(--cobalt)}
  .seg{display:flex;gap:8px;width:100%}
  .seg button{flex:1;height:52px;border-radius:99px;border:2px solid var(--ink);background:var(--white);font:800 16px/1 var(--display);color:var(--ink);cursor:pointer}
  .seg button[aria-pressed="true"]{background:var(--ink);color:var(--white)}
  .pickrow + :global(.offer){padding-top:24px}
  .src{padding-block:10px 50px;gap:10px}
  .src a{color:var(--cobalt)}
  @media (min-width:900px){ .two-packs{grid-template-columns:1fr 1fr} .stats div{padding:28px 24px} }
</style>
