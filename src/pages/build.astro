---
// /build: the pouch builder on its own page (docs/FUNNEL.md, MOFU "configurator" visitors).
// Packs to start from, the builder, saved packs, reorder links (/build?mix=...) and "email me this pouch".
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Promo from '../components/Promo.astro';
import Foot from '../components/Foot.astro';
import Builder from '../components/Builder.astro';
import { MAX_CAPS, TIERS, PRICE, perNight } from '../data/ingredients.js';
import { PREORDER, SHIP_BY } from '../data/preorder.js';
const FIRST = TIERS[0].each;
---
<Base
  title="Build your pouch | Blue Hour"
  description={`Start from a Blue Hour pack or build your own nightly pouch, up to ${MAX_CAPS} capsules. Save it and reorder in one tap. 30 pouches on a roll, free US shipping.`}
>
  <Promo text="Free US shipping on every roll. No subscription." />
  <header class="jhero" data-sec="build_hero">
    <div class="mesh"><i></i><i></i><i></i></div>
    <div class="grain"></div>
    <Top />
    <div class="in">
      <p class="crumb"><a href="/shop">Shop</a> / Build</p>
      <h1>Your pouch, your way.</h1>
      <p class="dek">Pick a pack below or build your own, up to {MAX_CAPS} capsules. Every roll is 30 of the same pouch, ${FIRST}{PREORDER ? ` (${perNight(FIRST)} a night), ships by ${SHIP_BY}` : ''}. Save it and reorder any time.</p>
    </div>
  </header>
  <Builder />
  <section class="sec" data-sec="build_help" style="background:#FAFBFF">
    <div class="w prose">
      <h2 style="color:var(--deep)">Not sure?</h2>
      <p>Take The Signature. It's our default for a reason, and you can change it next roll. If you take any medication, ask a pharmacist first, and leave out anything they flag. Every pouch keeps at least two glycine.</p>
      <p><a href="/shop">Back to the shop</a> · <a href="/shop#ingredients">What each capsule does</a> · <a href="/shop#tested">Lab reports</a></p>
    </div>
  </section>
  <Foot id="em-build" />
</Base>
