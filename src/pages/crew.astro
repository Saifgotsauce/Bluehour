---
// Founding Crew: the ambassador application. Numbers come from src/data/crew.js.
// Applications go to /api/crew, which saves them in Klaviyo.
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Foot from '../components/Foot.astro';
import Seals from '../components/Seals.astro';
import { CREW_SPOTS, CREW_OFF, CREW_RATE, FREE_ROLL_AT, BOOST_AT, BOOST_RATE, FIRST_BONUS, crewEarnings } from '../data/crew.js';
import { PRICE, PREORDER_TIERS, INGREDIENTS } from '../data/ingredients.js';
import { SHIP_BY } from '../data/preorder.js';
const FOUNDING = PREORDER_TIERS[0].each;
const WITH_CODE = FOUNDING - CREW_OFF;
const NIGHT = (WITH_CODE / 30).toFixed(2);
const SIG = INGREDIENTS.filter((i) => i.signature > 0);
const EXTRAS = INGREDIENTS.filter((i) => !i.signature).map((i) => i.name);
const EX = 6; // the example crew in the hero and the calculator's starting point
const EX3 = crewEarnings(EX * 3);
const M1 = crewEarnings(EX), M2 = crewEarnings(EX * 2) - M1, M3 = EX3 - M1 - M2; // what each example month adds
---
<Base
  title="Founding Crew | Blue Hour"
  description={`${CREW_SPOTS} spots. Your own code: $${CREW_RATE} for every roll your friends buy, $${CREW_RATE + FIRST_BONUS} on your first, and again every time they reorder. Nothing to buy.`}
>
  <header class="jhero crewhero">
    <div class="mesh"><i></i><i></i><i></i></div>
    <div class="grain"></div>
    <Top />
    <div class="in herogrid">
      <div class="herotext">
        <p class="kick">Blue Hour Founding Crew, {CREW_SPOTS} spots</p>
        <h1>Get paid every time they reorder.</h1>
        <p class="dek">Blue Hour is a 30-night roll of supplement pouches for nights out. Share your code and get ${CREW_RATE} for every roll your friends buy, ${CREW_RATE + FIRST_BONUS} on your first, and again every time they reorder. Nothing to buy.</p>
        <div class="ctas">
          <a class="btn solid" href="#apply">Apply in 2 minutes</a>
          <a class="btn hb" href="#earn">See what you'd make</a>
        </div>
        <p class="heronote">21+, US only. We read every application.</p>
      </div>

      <figure class="dash" aria-label={`Example: a member with ${EX} friends who reorder every month`}>
        <div class="dtop"><span>Your crew dashboard</span><em>Example</em></div>
        <p class="dhi">Earned in 3 months</p>
        <p class="dbig"><span>$</span><b id="dcount" data-to={EX3}>{EX3}</b></p>
        <ul class="drows">
          <li><div><b>Month 3</b><small>{EX} friends reordered{M3 > EX * CREW_RATE ? `, some at $${BOOST_RATE}` : ''}</small></div><i>+${M3}</i></li>
          <li><div><b>Month 2</b><small>{EX} friends reordered</small></div><i>+${M2}</i></li>
          <li><div><b>Month 1</b><small>{EX} rolls, with your ${FIRST_BONUS} first-sale bonus</small></div><i>+${M1}</i></li>
        </ul>
        <p class="dgoal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12.5 4 4L18 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>Free roll unlocked</p>
      </figure>
    </div>
  </header>

  <section class="sec sellband" aria-labelledby="sellh">
    <div class="w sellgrid">
      <figure class="rollfig">
        <img class="whatimg" src="/images/angle.webp" alt="A Blue Hour roll: a box with a strip of sealed pouches coming out of the top, each holding six capsules" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption>One roll: 30 sealed pouches, one for each night.</figcaption>
      </figure>
      <div class="selltext">
        <h2 id="sellh">What your friends get.</h2>
        <p class="whatbig">A specially curated pack for people who still have to show up tomorrow. 30 sealed pouches on one roll: pull one off when you get home, take the six capsules, done.</p>
        <div class="sixset">
          <p class="siglab">The signature six</p>
          <ul class="sigchips">
            {SIG.map((i) => <li><b>{i.name}{i.signature > 1 ? ` ×${i.signature}` : ''}</b><span>{i.ingredient}</span></li>)}
          </ul>
          <p class="sigmore">Or they build their own six, adding {EXTRAS.slice(0, -1).join(', ')} or {EXTRAS[EXTRAS.length - 1]}.</p>
        </div>
        <ul class="whatlist">
          
          <li>No caffeine, no 5-HTP, no stimulants.</li>
          <li>Every capsule tested by an outside lab, and every report is public.</li>
          <li>One roll is ${WITH_CODE} with your code, for all 30 nights. That's about ${NIGHT} a night, with a full refund any time before it ships.</li>
        </ul>
        <Seals prefix="c" class="crewseals" labHref="/shop#tested" />
      </div>
    </div>
  </section>

  <section class="w sec earn" id="earn" aria-labelledby="earnh">
    <div class="earngrid">
      <div class="calc" aria-labelledby="earnh">
        <h2 id="earnh">What would you make?</h2>
        <label class="calclabel" for="friends">Friends who grab a roll each month: <output id="fout" for="friends">{EX}</output></label>
        <input id="friends" type="range" min="1" max="30" step="1" value={EX} />
        <div class="paidrow">
          <div><p class="paid"><span class="cur">$</span><span id="pmonth">{EX * CREW_RATE}</span></p><p class="paidlab">a month</p></div>
          <div><p class="paid small"><span class="cur">$</span><span id="pyear">{crewEarnings(EX * 12)}</span></p><p class="paidlab">in your first year</p></div>
        </div>
        <p class="fine">If they reorder every month. Each friend counts once a month on your code. Includes your ${FIRST_BONUS} first-sale bonus and ${BOOST_RATE} a roll past {BOOST_AT}.</p>
      </div>

      <ul class="deal" aria-label="What you get">
        <li><b>${CREW_RATE} a roll, every reorder</b><span>Not just the first order. Every time a friend comes back, you get paid again.</span></li>
        <li><b>${CREW_RATE + FIRST_BONUS} on your first roll</b><span>A ${FIRST_BONUS} bonus on your first sale, so your first payout lands faster.</span></li>
        <li><b>A free roll after {FREE_ROLL_AT}</b><span>Your own roll, free, once {FREE_ROLL_AT} rolls have sold with your code.</span></li>
        <li><b>${BOOST_RATE} a roll after {BOOST_AT}</b><span>Every roll past your {BOOST_AT}th pays more.</span></li>
        <li><b>Your own live dashboard</b><span>Every sale shows up the moment it's paid, with what you've earned and when it pays out.</span></li>
        <li><b>${CREW_OFF} off for your friends</b><span>On every roll, so your code is an easy thing to pass on.</span></li>
      </ul>
    </div>
  </section>

  <section class="sec longgame" aria-labelledby="longh">
    <div class="w">
      <h2 id="longh">If Blue Hour gets <span class="bigword">BIG</span>, you come with it.</h2>
      <p class="longlede">The {CREW_SPOTS} people who get us off the ground don't get forgotten when we grow.</p>
      <ul class="longlist">
        <li><b>Your rate stays founding</b><span>If new members ever get paid less, you keep ${CREW_RATE} a roll, and ${BOOST_RATE} after {BOOST_AT}.</span></li>
        <li><b>First to get anything new</b><span>New capsules, smaller rolls, new drops. You get them before anyone else.</span></li>
        <li><b>First call when we hire</b><span>Ambassador leads, events and paid roles go to the Founding Crew first.</span></li>
        <li><b>On the list for our nights</b><span>When Blue Hour throws its own events, you and a friend are on the guest list.</span></li>
      </ul>
    </div>
  </section>

  <section class="w how" aria-labelledby="howh">
    <h2 id="howh">How it works.</h2>
    <ol class="steps">
      <li><b>Apply</b><span>About 2 minutes, right below. You go out a lot, people come with you, you're 21+ and in the US.</span></li>
      <li><b>Get your code</b><span>We check your page and email you either way. If you're in, you get your code and your dashboard link.</span></li>
      <li><b>Share it, get paid</b><span>Group chat, bio, out loud. We pay by PayPal every month. Pre-orders ship by {SHIP_BY}.</span></li>
    </ol>
  </section>

  <section class="apply" id="apply" aria-labelledby="applyh">
    <div class="w applygrid">
      <div class="bandslot">
        <div class="cband" id="cband" aria-hidden="true">
          <div class="cbin">
            <div class="cbhead">
              <img src="/images/logo-white.webp" alt="" width="1000" height="247" />
              <span>Founding Crew</span>
            </div>
            <p class="cbname" id="bname">Your name</p>
            <div class="cbfoot">
              <span id="bhandle">@yourhandle</span>
              <span class="cbcode">Code <b id="bcode">YOURCODE</b></span>
            </div>
            <span class="stamp" id="stamp">Applied</span>
          </div>
        </div>
        <p class="bandhint" id="bandhint">Your band fills in as you go.</p>
      </div>

      <div class="formcol">
        <h2 id="applyh">Claim your spot.</h2>
        <p class="lede">Takes about 2 minutes. We read every application and check your page. If you're in, your code and dashboard link come by email.</p>

        <form id="crewform" novalidate>
          <div class="f">
            <label for="cname">First name</label>
            <input id="cname" name="name" autocomplete="given-name" maxlength="60" required />
          </div>
          <div class="f">
            <label for="cemail">Email</label>
            <input id="cemail" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="two-f">
            <div class="f">
              <label for="cig">Instagram</label>
              <div class="at"><span>@</span><input id="cig" name="instagram" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="60" required /></div>
            </div>
            <div class="f">
              <label for="ctt">TikTok <em>if you have one</em></label>
              <div class="at"><span>@</span><input id="ctt" name="tiktok" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="60" /></div>
            </div>
          </div>
          <div class="f">
            <label for="ccity">Where you go out</label>
            <input id="ccity" name="city" placeholder="City or scene" maxlength="80" required />
          </div>
          <fieldset class="f">
            <legend>How often you're out</legend>
            <div class="pick">
              <label><input type="radio" name="often" value="weekly" /><span>Every weekend</span></label>
              <label><input type="radio" name="often" value="monthly" /><span>A few times a month</span></label>
              <label><input type="radio" name="often" value="festivals" /><span>Mostly festivals</span></label>
            </div>
          </fieldset>
          <fieldset class="f">
            <legend>How many people usually go out with you</legend>
            <div class="pick">
              <label><input type="radio" name="crew" value="1-3" /><span>1 to 3</span></label>
              <label><input type="radio" name="crew" value="4-8" /><span>4 to 8</span></label>
              <label><input type="radio" name="crew" value="9-15" /><span>9 to 15</span></label>
              <label><input type="radio" name="crew" value="15+" /><span>More than 15</span></label>
            </div>
          </fieldset>
          <fieldset class="f">
            <legend>Your biggest following <em>on any app</em></legend>
            <div class="pick">
              <label><input type="radio" name="reach" value="u500" /><span>Under 500</span></label>
              <label><input type="radio" name="reach" value="500-2k" /><span>500 to 2k</span></label>
              <label><input type="radio" name="reach" value="2k-10k" /><span>2k to 10k</span></label>
              <label><input type="radio" name="reach" value="10k+" /><span>10k+</span></label>
            </div>
            <div class="reachbox" id="reachbox" hidden>
              <p class="reachq">Where's that following?</p>
              <div class="pick">
                <label><input type="radio" name="rplat" value="instagram" /><span>Instagram</span></label>
                <label><input type="radio" name="rplat" value="tiktok" /><span>TikTok</span></label>
                <label><input type="radio" name="rplat" value="youtube" /><span>YouTube</span></label>
                <label><input type="radio" name="rplat" value="x" /><span>X</span></label>
                <label><input type="radio" name="rplat" value="twitch" /><span>Twitch</span></label>
                <label><input type="radio" name="rplat" value="other" /><span>Other</span></label>
              </div>
              <label for="crhandle" class="reachl">Username on that account</label>
              <div class="at"><span>@</span><input id="crhandle" name="rhandle" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="60" /></div>
            </div>
          </fieldset>
          <div class="f">
            <label for="ccode">Pick your code</label>
            <input id="ccode" name="code" class="codein" autocapitalize="characters" autocorrect="off" spellcheck="false" maxlength="12" required />
            <p class="help">Letters and numbers, 3 to 12 long. Your friends type this, so keep it easy to say out loud.</p>
          </div>
          <div class="f">
            <label for="cwhy">Why you? <em>optional</em></label>
            <textarea id="cwhy" name="why" rows="3" maxlength="400" placeholder="The shows you never miss, the group chats you run, the crew you bring"></textarea>
          </div>
          <div class="hp" aria-hidden="true"><label for="cweb">Website</label><input id="cweb" name="website" tabindex="-1" autocomplete="off" /></div>
          <label class="tick"><input type="checkbox" id="cadult" name="adult" required /><span>I'm 21 or older.</span></label>
          <label class="tick"><input type="checkbox" id="cnews" name="news" /><span>Email me Blue Hour news too.</span></label>
          <button class="btn blue send" type="submit" id="csend">Apply for a spot</button>
          <p class="formmsg" id="cmsg" role="status" aria-live="polite"></p>
        </form>

        <div class="done" id="cdone" hidden tabindex="-1">
          <h2>You're on the list.</h2>
          <p>We'll look at your page and email you either way. If you're in, your code and link come in that email.</p>
          <a class="btn solid" href="/shop">See the roll</a>
        </div>
      </div>
    </div>
  </section>

  <section class="w crewfaq faq" aria-labelledby="cfaqh">
    <h2 id="cfaqh">Crew questions.</h2>
    <details><summary><span class="q">Do I need a big following?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. We look at how often you go out and how many people go with you. A busy group chat counts as much as a big following.</p></details>
    <details><summary><span class="q">Do I have to buy anything?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. Joining is free and there's nothing to buy.</p></details>
    <details><summary><span class="q">Can I try it first?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Not yet. The first rolls ship by {SHIP_BY}. Once {FREE_ROLL_AT} rolls have sold with your code, your own roll is free. Until then, the lab reports for every capsule are on our <a href="/shop#tested">shop page</a>.</p></details>
    <details><summary><span class="q">What if my friends think 30 nights is a lot?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>A roll isn't 30 nights in a row. It's one pouch for every night you go out, so for most people it covers a lot of weekends. Or split one: two friends, 15 nights each, about ${(WITH_CODE / 2).toFixed(0)} each with your code.</p></details>
    <details><summary><span class="q">Why is 30 nights the only size?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Every roll is packed to order, pouch by pouch, in a cGMP-certified facility. Most of the cost is the packing, not the capsules, so a 10-night roll would cost nearly as much to make as 30. That's a bad deal for your friends, so we don't sell one yet. Bigger pre-order runs bring that cost down, and that's what gets us to smaller rolls like a weekend or festival pack. The Founding Crew gets those first.</p></details>
    <details><summary><span class="q">When do I get paid?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Once a month by PayPal. Pre-orders count 14 days after they ship, so the first payouts go out in January.</p></details>
    <details><summary><span class="q">Do I have to post?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No quotas. Share your code however works for you. If you do post about Blue Hour, add #ad or mark it as a paid partnership.</p></details>
    <details><summary><span class="q">Can friends outside the US order?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Not yet. We only ship within the US for now.</p></details>
  </section>

  <section class="w smallprint" aria-labelledby="sph">
    <h2 id="sph">The small print</h2>
    <ul>
      <li>Commission counts on orders that shipped and weren't refunded or disputed. Pre-orders count 14 days after they ship, and orders after launch count 30 days after they're placed. We pay by PayPal once a month.</li>
      <li>Your own orders never count. That means anything paid by you, shipped to your address or paid with your card, even if a friend places it.</li>
      <li>Each buyer counts once every 30 days on your code.</li>
      <li>Your code takes ${CREW_OFF} off every roll in the order. It doesn't combine with other codes.</li>
      <li>Don't post your code on coupon or deal sites, or run ads on the Blue Hour name. We pause codes that do.</li>
      <li>If an order is refunded or disputed after you've been paid for it, it comes off your next payout.</li>
      <li>The free roll is one per person. The ${FIRST_BONUS} first-sale bonus is paid once, on your first order that counts.</li>
      <li>Reorders count: a friend who buys again 30 or more days after their last counted order earns you commission again.</li>
      <li>When you post about Blue Hour, say it's a paid partnership or add #ad, and don't say it treats, cures or prevents anything, including hangovers.</li>
      <li>You need to be 21 or older to join.</li>
      <li>We can change or end the program with 30 days' notice by email. Anything you've already earned still gets paid. While the program runs, Founding Crew members keep the founding commission rates even if new members get less.</li>
    </ul>
  </section>

  <script define:vars={{ CREW_RATE, FREE_ROLL_AT, BOOST_AT, BOOST_RATE, FIRST_BONUS }}>
    (() => {
      const $ = (id) => document.getElementById(id);

      // ---- earnings calculator: friends who order each month ----
      const fr = $('friends'), fout = $('fout'), pm = $('pmonth'), py = $('pyear');
      const earn = (n) => (n ? FIRST_BONUS : 0) + Math.min(n, BOOST_AT) * CREW_RATE + Math.max(0, n - BOOST_AT) * BOOST_RATE;
      const calc = () => {
        const n = +fr.value;
        fout.textContent = n;
        pm.textContent = (n * CREW_RATE).toLocaleString('en-US');
        py.textContent = earn(n * 12).toLocaleString('en-US');
        fr.style.setProperty('--p', ((n - fr.min) / (fr.max - fr.min)) * 100 + '%');
      };
      fr.addEventListener('input', calc); calc();

      // ---- the example dashboard counts up once, when the page opens ----
      const dc = $('dcount');
      if (dc && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const to = +dc.dataset.to, t0 = performance.now(), dur = 900;
        dc.textContent = '0';
        const tick = (t) => {
          const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
          dc.textContent = Math.round(to * e);
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        document.querySelector('.dash').classList.add('go');
      }

      // ---- the band fills in as you type ----
      const f = $('crewform'), name = $('cname'), ig = $('cig'), code = $('ccode');
      let codeTouched = false;
      const cleanCode = (s) => String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 12);
      const handle = (s) => String(s || '').trim().replace(/^https?:\/\/(www\.)?(instagram|tiktok)\.com\//i, '').replace(/^@+/, '').replace(/[/?#].*$/, '');
      const band = () => {
        const n = name.value.trim();
        $('bname').textContent = n || 'Your name';
        $('bhandle').textContent = '@' + (handle(ig.value) || 'yourhandle');
        $('bcode').textContent = cleanCode(code.value) || 'YOURCODE';
        $('cband').classList.toggle('lit', !!(n || ig.value || code.value));
        const filled = [name, $('cemail'), ig, $('ccity'), code].filter((i) => i.value.trim()).length + (f.often.value ? 1 : 0) + (f.crew.value ? 1 : 0) + (f.reach.value ? 1 : 0);
        $('bandhint').textContent = filled >= 8 ? 'Looking good. Hit apply.' : 'Your band fills in as you go.';
      };
      name.addEventListener('input', () => {
        if (!codeTouched) code.value = cleanCode(name.value.split(/\s+/)[0]).slice(0, 8) + (name.value.trim() ? '5' : '');
        band();
      });
      code.addEventListener('input', () => {
        codeTouched = true;
        const p = code.selectionStart, before = code.value;
        code.value = cleanCode(code.value);
        if (before !== code.value) code.setSelectionRange(Math.min(p, code.value.length), Math.min(p, code.value.length));
        band();
      });
      // Picking a following size opens the box asking where that following is
      const rbox = $('reachbox');
      f.addEventListener('change', (e) => {
        if (e.target.name !== 'reach') return;
        const was = rbox.hidden; rbox.hidden = false;
        if (was && !f.rplat.value) {
          const ig = handle($('cig').value);
          if (ig) { f.querySelector('input[name=rplat][value=instagram]').checked = true; if (!$('crhandle').value) $('crhandle').value = ig; }
        }
      });
      f.addEventListener('input', band);
      f.addEventListener('change', band);

      // ---- send ----
      const LABELS = {
        name: 'Add your first name.', email: 'Check your email address.', instagram: 'Add your Instagram handle.',
        tiktok: 'Check your TikTok handle, or leave it empty.', city: 'Add where you go out.',
        often: 'Pick how often you go out.', crew: 'Pick how many people go out with you.', reach: 'Pick your biggest following, even if it is under 500.', rplat: 'Pick which app that following is on.', rhandle: 'Add the username for that account.', code: 'Your code needs 3 to 12 letters or numbers.', adult: 'You need to be 21 or older to join.',
      };
      const FIELD = { name: 'cname', email: 'cemail', instagram: 'cig', tiktok: 'ctt', city: 'ccity', often: null, crew: null, reach: null, rplat: null, rhandle: 'crhandle', code: 'ccode', adult: 'cadult' };
      const msg = $('cmsg'), send = $('csend');
      const flag = (err) => {
        f.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
        msg.textContent = LABELS[err] || 'Something on the form needs a look.';
        msg.className = 'formmsg bad';
        const id = FIELD[err];
        const el = id ? $(id) : f.querySelector(`input[name=${err}]`);
        if (el) { if (id) el.setAttribute('aria-invalid', 'true'); el.focus(); }
      };
      const check = (d) => {
        if (!d.name) return 'name';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email)) return 'email';
        if (!/^[A-Za-z0-9._]{1,30}$/.test(d.instagram)) return 'instagram';
        if (d.tiktok && !/^[A-Za-z0-9._]{1,30}$/.test(d.tiktok)) return 'tiktok';
        if (!d.city) return 'city';
        if (!d.often) return 'often';
        if (!d.crew) return 'crew';
        if (!d.reach) return 'reach';
        if (!d.rplat) return 'rplat';
        if (!/^[A-Za-z0-9._-]{1,40}$/.test(d.rhandle)) return 'rhandle';
        if (d.code.length < 3) return 'code';
        if (!d.adult) return 'adult';
        return '';
      };
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = {
          name: name.value.trim(), email: $('cemail').value.trim(), instagram: handle(ig.value), tiktok: handle($('ctt').value),
          city: $('ccity').value.trim(), often: f.often.value, crew: f.crew.value, reach: f.reach.value, rplat: f.rplat.value, rhandle: handle($('crhandle').value), code: cleanCode(code.value), why: $('cwhy').value.trim(),
          adult: $('cadult').checked, news: $('cnews').checked, website: $('cweb').value,
        };
        const err = check(d);
        if (err) return flag(err);
        send.disabled = true; send.textContent = 'Sending...';
        msg.textContent = ''; msg.className = 'formmsg';
        try {
          const res = await fetch('/api/crew', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(d) });
          const j = await res.json().catch(() => ({}));
          if (res.ok && j.ok) {
            $('cband').classList.add('stamped');
            $('bandhint').textContent = "Application in. We'll email you.";
            f.hidden = true; $('applyh').hidden = true; document.querySelector('.lede').hidden = true;
            const done = $('cdone'); done.hidden = false; done.focus();
            return;
          }
          if (j.error && LABELS[j.error]) return flag(j.error);
          throw new Error(j.error || 'failed');
        } catch (x) {
          msg.textContent = "That didn't send. Check your connection and try again, or email hello@bluehournights.com.";
          msg.className = 'formmsg bad';
        } finally {
          send.disabled = false; send.textContent = 'Apply for a spot';
        }
      });
    })();
  </script>
  <Foot id="em-crew" />
</Base>

