---
// Founding Crew: the ambassador application. Numbers come from src/data/crew.js.
// Applications go to /api/crew, which saves them in Klaviyo.
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Foot from '../components/Foot.astro';
import { CREW_SPOTS, CREW_OFF, CREW_RATE, FREE_ROLL_AT, BOOST_AT, BOOST_RATE } from '../data/crew.js';
---
<Base
  title="Founding Crew | Blue Hour"
  description={`${CREW_SPOTS} spots. Bring your people to Blue Hour, give them $${CREW_OFF} off every roll, and earn $${CREW_RATE} on every roll they buy.`}
>
  <header class="jhero crewhero">
    <div class="mesh"><i></i><i></i><i></i></div>
    <div class="grain"></div>
    <Top />
    <div class="in">
      <h1>Founding Crew.</h1>
      <p class="dek">{CREW_SPOTS} spots for the friend who's always there at the end of the night. Bring your people to Blue Hour and get paid on every roll they buy.</p>
      <div class="ctas">
        <a class="btn solid" href="#apply">Apply for a spot</a>
        <a class="btn hb" href="#earn">See what you earn</a>
      </div>
    </div>
  </header>

  <section class="w sec earn" id="earn" aria-labelledby="earnh">
    <h2 id="earnh">What you get.</h2>
    <div class="earngrid">
      <ul class="deal">
        <li><b>Your own code</b><span>Your friends get ${CREW_OFF} off their order when they use it.</span></li>
        <li><b>${CREW_RATE} a roll</b><span>For every roll your friends buy with your code. No cap.</span></li>
        <li><b>A free roll</b><span>Yours to keep once {FREE_ROLL_AT} rolls have sold with your code.</span></li>
        <li><b>${BOOST_RATE} a roll after {BOOST_AT}</b><span>Every roll past your {BOOST_AT}th pays more.</span></li>
        <li><b>Your name on our site</b><span>On the Founding Crew wall when we launch, and first in line for everything after.</span></li>
      </ul>

      <div class="calc" aria-labelledby="calch">
        <h3 id="calch">Do the maths</h3>
        <label class="calclabel" for="rolls">Rolls sold with your code: <output id="rollsout" for="rolls">8</output></label>
        <input id="rolls" type="range" min="0" max="40" step="1" value="8" />
        <p class="paid"><span class="cur">$</span><span id="paid">80</span></p>
        <p class="paidnote" id="paidnote" aria-live="polite">plus a free roll</p>
        <p class="fine">Paid by PayPal once a month, for rolls that have shipped. A crew of 3 friends each grabbing a roll is ${3 * CREW_RATE}.</p>
      </div>
    </div>
  </section>

  <section class="apply" id="apply" aria-labelledby="applyh">
    <div class="w applygrid">
      <div class="bandslot">
        <div class="cband" id="cband" aria-hidden="true">
          <div class="cbin">
            <div class="cbhead">
              <img src="/images/logo-white.webp" alt="" width="1000" height="247" />
              <span>Founding Crew</span>
            </div>
            <p class="cbname" id="bname">Your name</p>
            <div class="cbfoot">
              <span id="bhandle">@yourhandle</span>
              <span class="cbcode">Code <b id="bcode">YOURCODE</b></span>
            </div>
            <span class="stamp" id="stamp">Applied</span>
          </div>
        </div>
        <p class="bandhint" id="bandhint">Your band fills in as you go.</p>
      </div>

      <div class="formcol">
        <h2 id="applyh">Get on the list.</h2>
        <p class="lede">We read every application. If it's a fit, you'll get your code and link by email.</p>

        <form id="crewform" novalidate>
          <div class="f">
            <label for="cname">First name</label>
            <input id="cname" name="name" autocomplete="given-name" maxlength="60" required />
          </div>
          <div class="f">
            <label for="cemail">Email</label>
            <input id="cemail" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="two-f">
            <div class="f">
              <label for="cig">Instagram</label>
              <div class="at"><span>@</span><input id="cig" name="instagram" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="60" required /></div>
            </div>
            <div class="f">
              <label for="ctt">TikTok <em>if you have one</em></label>
              <div class="at"><span>@</span><input id="ctt" name="tiktok" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="60" /></div>
            </div>
          </div>
          <div class="f">
            <label for="ccity">Where you go out</label>
            <input id="ccity" name="city" placeholder="City or scene" maxlength="80" required />
          </div>
          <fieldset class="f">
            <legend>How often you're out</legend>
            <div class="pick">
              <label><input type="radio" name="often" value="weekly" /><span>Every weekend</span></label>
              <label><input type="radio" name="often" value="monthly" /><span>A few times a month</span></label>
              <label><input type="radio" name="often" value="festivals" /><span>Mostly festivals</span></label>
            </div>
          </fieldset>
          <div class="f">
            <label for="ccode">Pick your code</label>
            <input id="ccode" name="code" class="codein" autocapitalize="characters" autocorrect="off" spellcheck="false" maxlength="12" required />
            <p class="help">Letters and numbers, 3 to 12 long. Your friends type this, so keep it easy to say out loud.</p>
          </div>
          <div class="f">
            <label for="cwhy">Why you? <em>optional</em></label>
            <textarea id="cwhy" name="why" rows="3" maxlength="400" placeholder="The shows you never miss, your crew, what you post"></textarea>
          </div>
          <div class="hp" aria-hidden="true"><label for="cweb">Website</label><input id="cweb" name="website" tabindex="-1" autocomplete="off" /></div>
          <label class="tick"><input type="checkbox" id="cadult" name="adult" required /><span>I'm 18 or older.</span></label>
          <label class="tick"><input type="checkbox" id="cnews" name="news" /><span>Email me Blue Hour news too.</span></label>
          <button class="btn blue send" type="submit" id="csend">Apply for a spot</button>
          <p class="formmsg" id="cmsg" role="status" aria-live="polite"></p>
        </form>

        <div class="done" id="cdone" hidden tabindex="-1">
          <h2>You're on the list.</h2>
          <p>We'll look at your page and email you either way. If you're in, your code and link come in that email.</p>
          <a class="btn solid" href="/shop">See the roll</a>
        </div>
      </div>
    </div>
  </section>

  <section class="w smallprint" aria-labelledby="sph">
    <h2 id="sph">The small print</h2>
    <ul>
      <li>Commission counts on orders that shipped and weren't refunded or disputed. Pre-orders count 14 days after they ship, and orders after launch count 30 days after they're placed. We pay by PayPal once a month.</li>
      <li>Your own orders never count. That means anything paid by you, shipped to your address or paid with your card, even if a friend places it.</li>
      <li>Each buyer counts once every 30 days on your code.</li>
      <li>Your code takes ${CREW_OFF} off the order. It doesn't combine with other codes.</li>
      <li>Don't post your code on coupon or deal sites, or run ads on the Blue Hour name. We pause codes that do.</li>
      <li>If an order is refunded or disputed after you've been paid for it, it comes off your next payout.</li>
      <li>The free roll is one per person.</li>
      <li>When you post about Blue Hour, say it's a paid partnership or add #ad, and don't say it treats, cures or prevents anything, including hangovers.</li>
      <li>We can change or end the program with 30 days' notice by email. Anything you've already earned still gets paid.</li>
    </ul>
  </section>

  <script define:vars={{ CREW_RATE, FREE_ROLL_AT, BOOST_AT, BOOST_RATE }}>
    (() => {
      const $ = (id) => document.getElementById(id);

      // ---- earnings calculator ----
      const r = $('rolls'), out = $('rollsout'), paid = $('paid'), note = $('paidnote');
      const earn = (n) => Math.min(n, BOOST_AT) * CREW_RATE + Math.max(0, n - BOOST_AT) * BOOST_RATE;
      const calc = () => {
        const n = +r.value;
        out.textContent = n;
        paid.textContent = earn(n);
        r.style.setProperty('--p', (n / +r.max) * 100 + '%');
        const bits = [];
        if (n >= FREE_ROLL_AT) bits.push('plus a free roll');
        else bits.push(`${FREE_ROLL_AT - n} more for a free roll`);
        if (n > BOOST_AT) bits.push(`$${BOOST_RATE} a roll past ${BOOST_AT}`);
        note.textContent = bits.join(', ');
      };
      r.addEventListener('input', calc); calc();

      // ---- the band fills in as you type ----
      const f = $('crewform'), name = $('cname'), ig = $('cig'), code = $('ccode');
      let codeTouched = false;
      const cleanCode = (s) => String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 12);
      const handle = (s) => String(s || '').trim().replace(/^https?:\/\/(www\.)?(instagram|tiktok)\.com\//i, '').replace(/^@+/, '').replace(/[/?#].*$/, '');
      const band = () => {
        const n = name.value.trim();
        $('bname').textContent = n || 'Your name';
        $('bhandle').textContent = '@' + (handle(ig.value) || 'yourhandle');
        $('bcode').textContent = cleanCode(code.value) || 'YOURCODE';
        $('cband').classList.toggle('lit', !!(n || ig.value || code.value));
        const filled = [name, $('cemail'), ig, $('ccity'), code].filter((i) => i.value.trim()).length + (f.often.value ? 1 : 0);
        $('bandhint').textContent = filled >= 6 ? 'Looking good. Hit apply.' : 'Your band fills in as you go.';
      };
      name.addEventListener('input', () => {
        if (!codeTouched) code.value = cleanCode(name.value.split(/\s+/)[0]).slice(0, 8) + (name.value.trim() ? '5' : '');
        band();
      });
      code.addEventListener('input', () => {
        codeTouched = true;
        const p = code.selectionStart, before = code.value;
        code.value = cleanCode(code.value);
        if (before !== code.value) code.setSelectionRange(Math.min(p, code.value.length), Math.min(p, code.value.length));
        band();
      });
      f.addEventListener('input', band);
      f.addEventListener('change', band);

      // ---- send ----
      const LABELS = {
        name: 'Add your first name.', email: 'Check your email address.', instagram: 'Add your Instagram handle.',
        tiktok: 'Check your TikTok handle, or leave it empty.', city: 'Add where you go out.',
        often: 'Pick how often you go out.', code: 'Your code needs 3 to 12 letters or numbers.', adult: 'You need to be 18 or older to join.',
      };
      const FIELD = { name: 'cname', email: 'cemail', instagram: 'cig', tiktok: 'ctt', city: 'ccity', often: null, code: 'ccode', adult: 'cadult' };
      const msg = $('cmsg'), send = $('csend');
      const flag = (err) => {
        f.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
        msg.textContent = LABELS[err] || 'Something on the form needs a look.';
        msg.className = 'formmsg bad';
        const id = FIELD[err];
        const el = id ? $(id) : f.querySelector('input[name=often]');
        if (el) { if (id) el.setAttribute('aria-invalid', 'true'); el.focus(); }
      };
      const check = (d) => {
        if (!d.name) return 'name';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email)) return 'email';
        if (!/^[A-Za-z0-9._]{1,30}$/.test(d.instagram)) return 'instagram';
        if (d.tiktok && !/^[A-Za-z0-9._]{1,30}$/.test(d.tiktok)) return 'tiktok';
        if (!d.city) return 'city';
        if (!d.often) return 'often';
        if (d.code.length < 3) return 'code';
        if (!d.adult) return 'adult';
        return '';
      };
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = {
          name: name.value.trim(), email: $('cemail').value.trim(), instagram: handle(ig.value), tiktok: handle($('ctt').value),
          city: $('ccity').value.trim(), often: f.often.value, code: cleanCode(code.value), why: $('cwhy').value.trim(),
          adult: $('cadult').checked, news: $('cnews').checked, website: $('cweb').value,
        };
        const err = check(d);
        if (err) return flag(err);
        send.disabled = true; send.textContent = 'Sending...';
        msg.textContent = ''; msg.className = 'formmsg';
        try {
          const res = await fetch('/api/crew', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(d) });
          const j = await res.json().catch(() => ({}));
          if (res.ok && j.ok) {
            $('cband').classList.add('stamped');
            $('bandhint').textContent = "Application in. We'll email you.";
            f.hidden = true; $('applyh').hidden = true; document.querySelector('.lede').hidden = true;
            const done = $('cdone'); done.hidden = false; done.focus();
            return;
          }
          if (j.error && LABELS[j.error]) return flag(j.error);
          throw new Error(j.error || 'failed');
        } catch (x) {
          msg.textContent = "That didn't send. Check your connection and try again, or email hello@bluehournights.com.";
          msg.className = 'formmsg bad';
        } finally {
          send.disabled = false; send.textContent = 'Apply for a spot';
        }
      });
    })();
  </script>
  <Foot id="em-crew" />
</Base>

<style>
  .crewhero{padding-bottom:calc(var(--rise) + 60px)}
  .crewhero h1{font-size:clamp(58px,16vw,128px);line-height:.92;letter-spacing:-.05em;font-style:italic}
  .crewhero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:10px}
  .crewhero .btn.hb{background:transparent;border-color:var(--white);color:var(--white)}

  /* what you get */
  .earn h2{margin-bottom:clamp(28px,6vw,52px)}
  .earngrid{display:grid;gap:clamp(36px,7vw,72px);align-items:start}
  .deal{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
  .deal li{display:grid;gap:4px;padding:18px 0;border-bottom:1px solid var(--line)}
  .deal b{font:800 clamp(24px,6.4vw,34px)/1.1 var(--display);letter-spacing:-.03em;color:var(--cobalt)}
  .deal span{color:var(--soft);max-width:34em}
  .calc{position:relative;overflow:hidden;isolation:isolate;border-radius:28px;padding:clamp(24px,5vw,40px);color:var(--white);background:linear-gradient(180deg,var(--deep),var(--cobalt) 55%,var(--bright))}
  .calc h3{margin-bottom:18px}
  .calclabel{display:block;font-weight:600;margin-bottom:12px}
  .calclabel output{font-weight:800}
  .calc input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:12px;border-radius:99px;outline-offset:6px;cursor:pointer;background:linear-gradient(90deg,var(--white) var(--p,20%),rgba(255,255,255,.22) var(--p,20%))}
  .calc input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:34px;height:34px;border-radius:50%;background:var(--white);border:3px solid var(--deep);box-shadow:0 6px 14px rgba(3,10,60,.4)}
  .calc input[type=range]::-moz-range-thumb{width:28px;height:28px;border-radius:50%;background:var(--white);border:3px solid var(--deep)}
  .paid{display:flex;align-items:flex-start;font:900 clamp(84px,24vw,148px)/.9 var(--display);letter-spacing:-.06em;margin-top:26px;font-style:italic}
  .paid .cur{font-size:.42em;margin:.12em .06em 0 0;font-style:normal}
  .paidnote{font:700 clamp(18px,4.8vw,22px)/1.3 var(--display);color:var(--first);min-height:1.3em;margin:6px 0 18px}
  .calc .fine{color:#C9D6FF}

  /* apply */
  .apply{background:var(--mist);padding-block:clamp(56px,11vw,110px)}
  .applygrid{display:grid;gap:30px;align-items:start}
  .bandslot{position:sticky;top:10px;z-index:5}
  .cband{transform:rotate(-2.4deg);transition:transform .6s var(--ease-out)}
  .cband.lit{transform:rotate(-1deg)}
  .cbin{position:relative;overflow:hidden;isolation:isolate;display:grid;gap:6px;padding:14px 18px 14px 34px;border-radius:20px;color:var(--white);background:linear-gradient(100deg,#0B1F9E,var(--cobalt) 42%,#2A62F0 72%,var(--dawn));box-shadow:0 18px 40px rgba(7,18,104,.35),inset 0 0 0 1.5px rgba(255,255,255,.32)}
  .cbin::before{content:"";position:absolute;left:15px;top:12px;bottom:12px;border-left:2px dashed rgba(255,255,255,.5)}
  .cbhead{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .cbhead img{width:min(104px,28vw);height:auto}
  .cbhead span{font:700 10.5px/1.2 var(--display);letter-spacing:.12em;white-space:nowrap;text-transform:uppercase;opacity:.88;text-align:right}
  .cbhead i{font-style:normal}
  .cbname{font:900 clamp(28px,8vw,52px)/.95 var(--display);font-style:italic;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
  .cbfoot{display:flex;justify-content:space-between;align-items:center;gap:10px;font:600 14px/1.2 var(--display);min-width:0}
  .cbfoot>span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;opacity:.92}
  .cbcode{flex:0 0 auto;background:var(--white);color:var(--deep);border-radius:99px;padding:6px 12px;font-size:12px}
  .cbcode b{font-weight:900;letter-spacing:.04em}
  .stamp{position:absolute;left:52%;top:54%;font:900 clamp(26px,7vw,40px)/1 var(--display);letter-spacing:-.02em;font-style:italic;color:var(--white);border:4px solid var(--white);border-radius:14px;padding:6px 14px;transform:translate(-50%,-50%) rotate(-12deg) scale(2.2);opacity:0;pointer-events:none}
  .cband.stamped .stamp{animation:stamp .55s cubic-bezier(.3,1.4,.5,1) forwards}
  .cband.stamped .cbname,.cband.stamped .cbfoot{opacity:.55}
  @keyframes stamp{to{opacity:1;transform:translate(-50%,-50%) rotate(-12deg) scale(1)}}
  .bandhint{font:600 13px/1.3 var(--display);color:var(--soft);margin:10px 0 0 6px}

  .formcol h2{margin-bottom:12px}
  .lede{color:var(--soft);margin-bottom:28px}
  #crewform{display:grid;gap:20px;max-width:620px}
  .f{display:grid;gap:8px;border:0;margin:0;padding:0;min-width:0}
  .f label,.f legend{font:700 15px/1.2 var(--display);letter-spacing:-.01em;padding:0}
  .f em{font-style:normal;font-weight:500;color:var(--soft)}
  .f input,.f textarea{width:100%;min-width:0;border:2px solid var(--ink);border-radius:16px;background:var(--white);padding:15px 16px;font-size:17px;outline:0;transition:box-shadow .25s var(--ease-out)}
  .f textarea{font:inherit;font-size:17px;resize:vertical;min-height:96px;line-height:1.45}
  .f input:focus,.f textarea:focus{box-shadow:0 0 0 4px var(--pale)}
  .f input[aria-invalid],.f textarea[aria-invalid]{border-color:#D3203B;box-shadow:0 0 0 4px rgba(211,32,59,.15)}
  .two-f{display:grid;gap:20px}
  .at{display:flex;align-items:center;border:2px solid var(--ink);border-radius:16px;background:var(--white);transition:box-shadow .25s var(--ease-out)}
  .at:focus-within{box-shadow:0 0 0 4px var(--pale)}
  .at span{padding-left:16px;font-weight:700;color:var(--soft)}
  .at input{border:0;border-radius:16px;padding-left:4px}
  .at input:focus{box-shadow:none}
  .codein{font:900 22px/1 var(--display)!important;letter-spacing:.06em;text-transform:uppercase;color:var(--cobalt)}
  .help{font-size:14px;color:var(--soft)}
  .pick{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
  .pick label{position:relative;cursor:pointer}
  .pick input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  .pick span{display:block;padding:12px 18px;border:2px solid var(--ink);border-radius:99px;background:var(--white);font:700 15px/1.2 var(--display);transition:background-color .25s,color .25s,transform .3s var(--ease-out)}
  .pick input:checked+span{background:var(--ink);color:var(--white);transform:rotate(-2deg)}
  .pick input:focus-visible+span{outline:3px solid var(--dawn);outline-offset:3px}
  .tick{display:flex;align-items:center;gap:12px;font-weight:600;cursor:pointer}
  .tick input{width:24px;height:24px;flex:0 0 24px;accent-color:var(--cobalt)}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .send{justify-self:start;margin-top:6px}
  .send:disabled{opacity:.6;cursor:wait}
  .formmsg{font-weight:600;min-height:1.4em}
  .formmsg.bad{color:#C01633}
  .done{display:grid;gap:16px;justify-items:start;max-width:520px;outline:0}

  .smallprint{padding-block:clamp(48px,9vw,90px)}
  .smallprint h2{font-size:clamp(24px,6vw,32px);margin-bottom:16px}
  .smallprint ul{margin:0;padding-left:20px;display:grid;gap:10px;color:var(--soft);font-size:15px;max-width:62ch}

  @media (min-width:900px){
    .earngrid{grid-template-columns:1.1fr 1fr}
    .calc{position:sticky;top:24px}
    .applygrid{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:64px}
    .applygrid .formcol{grid-row:1}
    .bandslot{top:40px;grid-column:2;grid-row:1;padding-top:76px}
    .cbin{padding:22px 26px 22px 44px;gap:10px}
    .cbin::before{left:20px}
    .two-f{grid-template-columns:1fr 1fr}
    .applygrid{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}
    .applygrid .formcol{grid-column:1}
  }
  @media (prefers-reduced-motion:reduce){
    .cband,.cband.lit{transition:none}
    .cband.stamped .stamp{animation:none;opacity:1;transform:translate(-50%,-50%) rotate(-12deg)}
  }
</style>
