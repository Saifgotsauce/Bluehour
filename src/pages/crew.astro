---
// Founding Crew: the ambassador application. Numbers come from src/data/crew.js.
// Applications go to /api/crew, which saves them in Klaviyo.
//
// Built for people tapping in from Instagram on a phone: the first screen says what Blue Hour is,
// what they earn, and has the whole form (name, Instagram, email, 21+). Everything else is below it.
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Foot from '../components/Foot.astro';
import { CREW_SPOTS, CREW_OFF, CREW_RATE, FREE_ROLL_AT, BOOST_AT, BOOST_RATE, FIRST_BONUS } from '../data/crew.js';
import { PREORDER_TIERS } from '../data/ingredients.js';
import { SHIP_BY } from '../data/preorder.js';
const FOUNDING = PREORDER_TIERS[0].each;
const WITH_CODE = FOUNDING - CREW_OFF;
const NIGHT = (WITH_CODE / 30).toFixed(2);
---
<Base
  title="Founding Crew | Blue Hour"
  description={`Get $${CREW_RATE} every time a friend buys Blue Hour with your code, and again when they reorder. Free to join, nothing to buy. ${CREW_SPOTS} spots.`}
>
  <header class="jhero crewhero">
    <div class="mesh"><i></i><i></i><i></i></div>
    <div class="grain"></div>
    <Top />
    <div class="in herogrid">
      <div class="herotext">
        <p class="hook">Out every weekend anyway?</p>
        <h1>Get ${CREW_RATE} every time a friend buys Blue Hour.</h1>
        <p class="dek">Blue Hour is one pouch of six supplements for after a night out. Your code gets friends ${CREW_OFF} off. You get ${CREW_RATE} every time they buy, and again when they reorder. Free to join.</p>
      </div>

      <div class="applycard" id="apply">
        <form id="crewform" novalidate aria-labelledby="applyh">
          <h2 id="applyh">Apply for a spot</h2>
          <div class="f">
            <label for="cname">First name</label>
            <input id="cname" name="name" autocomplete="given-name" maxlength="60" required />
          </div>
          <div class="f">
            <label for="cig">Instagram</label>
            <div class="at"><span>@</span><input id="cig" name="instagram" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="60" required /></div>
          </div>
          <div class="f">
            <label for="cemail">Email</label>
            <input id="cemail" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="hp" aria-hidden="true"><label for="cweb">Website</label><input id="cweb" name="website" tabindex="-1" autocomplete="off" /></div>
          <label class="tick"><input type="checkbox" id="cadult" name="adult" required /><span>I'm 21 or older and in the US.</span></label>
          <label class="tick small"><input type="checkbox" id="cnews" name="news" /><span>Email me Blue Hour news too.</span></label>
          <button class="btn blue send" type="submit" id="csend">Apply for a spot</button>
          <p class="formmsg" id="cmsg" role="status" aria-live="polite"></p>
          <p class="cardnote">{CREW_SPOTS} spots. We look at your page and email you either way.</p>
        </form>

        <div class="done" id="cdone" hidden tabindex="-1">
          <h2>You applied.</h2>
          <p>We'll look at your Instagram and email you either way. If you're in, you'll pick your code and get your dashboard link in that email.</p>
          <a class="btn solid" href="/shop">See what your friends get</a>
        </div>
      </div>
    </div>
  </header>

  <section class="sec sellband" aria-labelledby="sellh">
    <div class="w sellgrid">
      <img class="whatimg" src="/images/angle.webp" alt="A Blue Hour roll: a box with a strip of sealed pouches coming out of the top, each holding six capsules" width="1122" height="1402" loading="lazy" decoding="async" />
      <div class="selltext">
        <h2 id="sellh">What your friends get</h2>
        <p class="big">A roll of 30 sealed pouches. When they get home, they pull one off and take the six capsules.</p>
        <ul class="plain">
          <li>Magnesium, vitamin C, B vitamins, zinc and glycine.</li>
          <li>No caffeine, no stimulants. Every capsule is lab tested.</li>
          <li>${WITH_CODE} with your code, about ${NIGHT} a night. Ships by {SHIP_BY}.</li>
        </ul>
        <a class="btn" href="/shop">See the roll</a>
      </div>
    </div>
  </section>

  <section class="w sec paid" aria-labelledby="paidh">
    <h2 id="paidh">How you get paid</h2>
    <ol class="steps">
      <li><b>Apply</b><span>Takes 30 seconds, at the top of this page.</span></li>
      <li><b>Get your code</b><span>If you're in, we email you your code and a dashboard to track sales.</span></li>
      <li><b>Friends buy, you get ${CREW_RATE}</b><span>Every roll, every reorder. Paid monthly by PayPal.</span></li>
    </ol>
    <ul class="deal" aria-label="What you earn">
      <li><b>${CREW_RATE + FIRST_BONUS}</b><span>on your first sale</span></li>
      <li><b>${CREW_RATE}</b><span>every roll after that, reorders too</span></li>
      <li><b>Free roll</b><span>for you after {FREE_ROLL_AT} sales</span></li>
      <li><b>${BOOST_RATE}</b><span>a roll after {BOOST_AT} sales</span></li>
    </ul>
  </section>

  <section class="w crewfaq faq" aria-labelledby="cfaqh">
    <h2 id="cfaqh">Questions</h2>
    <details><summary><span class="q">Do I need a big following?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. We look at how often you go out and how many people go with you. A busy group chat counts as much as a big following.</p></details>
    <details><summary><span class="q">Do I have to buy anything?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. Joining is free and there's nothing to buy.</p></details>
    <details><summary><span class="q">Do I have to post?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No quotas. Share your code however works for you: group chat, bio, out loud. If you do post about Blue Hour, add #ad or mark it as a paid partnership.</p></details>
    <details><summary><span class="q">Can I try it first?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Not yet. The first rolls ship by {SHIP_BY}. Once {FREE_ROLL_AT} rolls have sold with your code, your own roll is free. Until then, the lab reports for every capsule are on our <a href="/shop#tested">shop page</a>.</p></details>
    <details><summary><span class="q">What if my friends think 30 nights is a lot?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>It's not 30 nights in a row. It's one pouch for every night out, so it covers a lot of weekends. Or two friends can split one, about ${(WITH_CODE / 2).toFixed(0)} each with your code.</p></details>
    <details><summary><span class="q">Why is 30 nights the only size?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Every roll is packed to order, pouch by pouch, in a cGMP-certified facility. Most of the cost is the packing, so a 10-night roll would cost nearly as much to make as 30. Bigger pre-order runs bring that cost down, and that's what gets us to smaller rolls. The Founding Crew gets those first.</p></details>
    <details><summary><span class="q">When do I get paid?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Once a month by PayPal. Pre-orders count 14 days after they ship, so the first payouts go out in January.</p></details>
    <details><summary><span class="q">What do the first {CREW_SPOTS} get if Blue Hour grows?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>You keep the founding rate (${CREW_RATE} a roll, ${BOOST_RATE} after {BOOST_AT}) even if new members get less. You also get new capsules, smaller rolls and drops first, first call on paid roles and events, and a spot for you and a friend on the list when Blue Hour throws its own nights.</p></details>
    <details><summary><span class="q">Can friends outside the US order?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Not yet. We only ship within the US for now.</p></details>
  </section>

  <section class="w again" aria-label="Apply">
    <a class="btn blue" href="#apply" id="backup">Apply for a spot</a>
  </section>

  <section class="w smallprint" aria-labelledby="sph">
    <h2 id="sph">The small print</h2>
    <ul>
      <li>Commission counts on orders that shipped and weren't refunded or disputed. Pre-orders count 14 days after they ship, and orders after launch count 30 days after they're placed. We pay by PayPal once a month.</li>
      <li>Your own orders never count. That means anything paid by you, shipped to your address or paid with your card, even if a friend places it.</li>
      <li>Each buyer counts once every 30 days on your code.</li>
      <li>Your code takes ${CREW_OFF} off every roll in the order. It doesn't combine with other codes.</li>
      <li>Don't post your code on coupon or deal sites, or run ads on the Blue Hour name. We pause codes that do.</li>
      <li>If an order is refunded or disputed after you've been paid for it, it comes off your next payout.</li>
      <li>The free roll is one per person. The ${FIRST_BONUS} first-sale bonus is paid once, on your first order that counts.</li>
      <li>Reorders count: a friend who buys again 30 or more days after their last counted order earns you commission again.</li>
      <li>When you post about Blue Hour, say it's a paid partnership or add #ad, and don't say it treats, cures or prevents anything, including hangovers.</li>
      <li>You need to be 21 or older to join.</li>
      <li>We can change or end the program with 30 days' notice by email. Anything you've already earned still gets paid. While the program runs, Founding Crew members keep the founding commission rates even if new members get less.</li>
    </ul>
  </section>

  <script>
    (() => {
      const $ = (id) => document.getElementById(id);
      const f = $('crewform'), msg = $('cmsg'), send = $('csend');
      const handle = (s) => String(s || '').trim().replace(/^https?:\/\/(www\.)?(instagram|tiktok)\.com\//i, '').replace(/^@+/, '').replace(/[/?#].*$/, '');

      // The button lower down jumps back to the form and puts the cursor in the first field
      $('backup').addEventListener('click', () => setTimeout(() => $('cname').focus({ preventScroll: true }), 400));

      const LABELS = {
        name: 'Add your first name.', email: 'Check your email address.', instagram: 'Add your Instagram handle.',
        code: 'Something went wrong with your code. Try again.', adult: 'You need to be 21 or older to join.',
      };
      const FIELD = { name: 'cname', email: 'cemail', instagram: 'cig', adult: 'cadult' };
      const flag = (err) => {
        f.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
        msg.textContent = LABELS[err] || 'Something on the form needs a look.';
        msg.className = 'formmsg bad';
        const el = FIELD[err] && $(FIELD[err]);
        if (el) { el.setAttribute('aria-invalid', 'true'); el.focus(); }
      };
      const check = (d) => {
        if (!d.name) return 'name';
        if (!/^[A-Za-z0-9._]{1,30}$/.test(d.instagram)) return 'instagram';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email)) return 'email';
        if (!d.adult) return 'adult';
        return '';
      };
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = {
          name: $('cname').value.trim(), instagram: handle($('cig').value), email: $('cemail').value.trim(),
          adult: $('cadult').checked, news: $('cnews').checked, website: $('cweb').value,
        };
        const err = check(d);
        if (err) return flag(err);
        send.disabled = true; send.textContent = 'Sending...';
        msg.textContent = ''; msg.className = 'formmsg';
        try {
          const res = await fetch('/api/crew', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(d) });
          const j = await res.json().catch(() => ({}));
          if (res.ok && j.ok) {
            f.hidden = true;
            const done = $('cdone'); done.hidden = false; done.focus();
            $('backup').closest('section').hidden = true;
            return;
          }
          if (j.error && LABELS[j.error]) return flag(j.error);
          throw new Error(j.error || 'failed');
        } catch (x) {
          msg.textContent = "That didn't send. Check your connection and try again, or email hello@bluehournights.com.";
          msg.className = 'formmsg bad';
        } finally {
          send.disabled = false; send.textContent = 'Apply for a spot';
        }
      });
    })();
  </script>
  <Foot id="em-crew" />
</Base>

<style>
  /* hero: the pitch and the whole form, in the first screen on a phone */
  .crewhero .in{padding-top:calc(84px + 2vw)}
  .herogrid{display:grid;gap:24px;align-items:start;width:100%}
  .herotext{display:grid;gap:12px}
  .hook{margin:0;font:700 clamp(17px,4.6vw,22px)/1.2 var(--display);color:var(--first)}
  .crewhero h1{font-size:clamp(36px,10vw,78px);line-height:1;letter-spacing:-.045em;max-width:11em;margin:0}
  .crewhero .dek{font-size:clamp(16px,4.2vw,20px);line-height:1.45;max-width:30em;margin:0}

  .applycard{width:100%;max-width:480px;background:var(--white);color:var(--ink);border-radius:26px;padding:clamp(20px,5vw,30px);box-shadow:0 26px 60px rgba(3,10,70,.34);scroll-margin-top:16px}
  #crewform{display:grid;gap:12px}
  #applyh{font-size:clamp(24px,6.4vw,30px);letter-spacing:-.03em;color:var(--deep)}
  .f{display:grid;gap:6px;min-width:0}
  .f label{font:700 15px/1.2 var(--display);letter-spacing:-.01em}
  .f input{width:100%;min-width:0;border:2px solid var(--ink);border-radius:14px;background:var(--white);padding:12px 16px;font-size:17px;outline:0;transition:box-shadow .25s var(--ease-out)}
  .f input:focus{box-shadow:0 0 0 4px var(--pale)}
  .f input[aria-invalid]{border-color:#D3203B;box-shadow:0 0 0 4px rgba(211,32,59,.15)}
  .at{display:flex;align-items:center;border:2px solid var(--ink);border-radius:14px;background:var(--white);transition:box-shadow .25s var(--ease-out)}
  .at:focus-within{box-shadow:0 0 0 4px var(--pale)}
  .at:has([aria-invalid]){border-color:#D3203B}
  .at span{padding-left:16px;font-weight:700;color:var(--soft)}
  .at input{border:0;border-radius:14px;padding-left:4px}
  .at input:focus{box-shadow:none}
  .tick{display:flex;align-items:center;gap:12px;font-weight:600;cursor:pointer;line-height:1.3}
  .tick input{width:24px;height:24px;flex:0 0 24px;accent-color:var(--cobalt)}
  .tick input:focus-visible{outline:3px solid var(--dawn);outline-offset:3px}
  .tick input[aria-invalid]{outline:3px solid #D3203B;outline-offset:2px}
  .tick.small{font-size:14px;font-weight:500;color:var(--soft)}
  .tick.small input{width:20px;height:20px;flex-basis:20px}
  .send{width:100%;margin-top:4px}
  .send:disabled{opacity:.6;cursor:wait}
  .formmsg{font-weight:600;margin:0;font-size:15px}
  .formmsg:empty{display:none}
  .formmsg.bad{color:#C01633}
  .cardnote{margin:0;font-size:14px;color:var(--soft);text-align:center}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .done{display:grid;gap:14px;justify-items:start;outline:0}
  .done h2{font-size:clamp(28px,7vw,36px);color:var(--deep)}
  .done p{margin:0;color:var(--soft)}

  /* what your friends get */
  .sellband{background:var(--mist)}
  .sellgrid{display:grid;gap:28px;align-items:center}
  .whatimg{width:70%;max-width:400px;height:auto;border-radius:26px;justify-self:center;box-shadow:0 24px 50px rgba(11,31,158,.16)}
  .selltext{display:grid;gap:18px;justify-items:start}
  .selltext h2{color:var(--deep);font-size:clamp(30px,8vw,52px)}
  .big{font:600 clamp(19px,5vw,24px)/1.35 var(--display);letter-spacing:-.015em;margin:0;max-width:26em}
  .plain{margin:0;padding:0;list-style:none;display:grid;gap:10px;color:var(--soft);max-width:34em}
  .plain li{padding-left:22px;position:relative}
  .plain li::before{content:"";position:absolute;left:0;top:.55em;width:9px;height:9px;border-radius:50%;background:var(--cobalt)}

  /* how you get paid */
  .paid h2{font-size:clamp(30px,8vw,52px);margin-bottom:clamp(20px,5vw,34px)}
  .steps{list-style:none;margin:0;padding:0;display:grid;counter-reset:s}
  .steps li{counter-increment:s;display:grid;grid-template-columns:auto 1fr;column-gap:16px;row-gap:2px;padding:16px 0;border-top:1px solid var(--line)}
  .steps li::before{content:counter(s);grid-row:span 2;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--cobalt);color:var(--white);font:800 18px/1 var(--display)}
  .steps b{font:800 clamp(19px,5vw,24px)/1.2 var(--display);letter-spacing:-.02em}
  .steps span{color:var(--soft)}
  .deal{list-style:none;margin:clamp(24px,5vw,40px) 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .deal li{display:grid;gap:2px;align-content:start;padding:16px;border-radius:18px;background:var(--mist)}
  .deal b{font:800 clamp(26px,7vw,38px)/1 var(--display);letter-spacing:-.04em;color:var(--cobalt)}
  .deal span{font-size:15px;line-height:1.3;color:var(--ink)}

  /* faq, last call, small print */
  .crewfaq{padding-top:clamp(40px,8vw,80px)}
  .crewfaq h2{color:var(--deep);margin-bottom:8px;font-size:clamp(30px,8vw,52px)}
  .crewfaq p{max-width:60ch}
  .crewfaq p a{color:var(--cobalt);font-weight:700}
  .again{padding-top:clamp(36px,7vw,60px);display:flex;justify-content:center}
  .smallprint{padding-block:clamp(48px,9vw,90px)}
  .smallprint h2{font-size:clamp(22px,5.6vw,28px);margin-bottom:14px}
  .smallprint ul{margin:0;padding-left:20px;display:grid;gap:10px;color:var(--soft);font-size:14px;max-width:62ch}

  @media (min-width:900px){
    .herogrid{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:56px;align-items:center}
    .applycard{justify-self:end}
    .sellgrid{grid-template-columns:minmax(0,.8fr) minmax(0,1fr)}
    .whatimg{width:82%}
    .steps{grid-template-columns:repeat(3,1fr);gap:28px}
    .steps li{grid-template-columns:1fr;border-top:2px solid var(--ink)}
    .steps li::before{grid-row:auto;margin-bottom:8px}
    .deal{grid-template-columns:repeat(4,1fr)}
  }
</style>
