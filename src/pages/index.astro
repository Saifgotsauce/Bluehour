---
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Promo from '../components/Promo.astro';
import Marquee from '../components/Marquee.astro';
import Foot from '../components/Foot.astro';
import { PREORDER, SHIP_BY } from '../data/preorder.js';
import { TIERS, PRICE, perNight } from '../data/ingredients.js';
const FIRST = TIERS[0].each;
const site = Astro.site!;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Blue Hour',
  url: site.href,
  logo: new URL('/favicon-512.png', site).href,
};
---
<Base
  title="Blue Hour | One nightly pouch for big nights"
  description="Out late. Up early. One pouch a night with magnesium, vitamin C, B vitamins, zinc and glycine, for people who dance till close, train hard and still show up. Free US shipping."
  jsonld={jsonld}
>

  <Promo text="Free US shipping on every roll." link="Shop 30 nights" href="/shop" />
  <header class="hero">
    <div class="mesh"><i></i><i></i><i></i></div><div class="grain"></div>
    <Top />
    <div class="copy">
      <h1><span class="ln"><span>Out late.</span></span><span class="ln"><span style="--d:.09s">Up early.</span></span></h1>
      <p class="sub">Monday doesn't care what time you got home. Blue Hour is one pouch a night for people who dance till close, train hard and still show up.</p>
      <a class="btn" href="/shop">{PREORDER ? 'Pre-order now' : 'Buy now'}</a>
      <p class="note">{PREORDER ? `30 nights. $${FIRST} founding price (launch $${PRICE}). Ships by ${SHIP_BY}.` : `30 nights. $${PRICE}. Free US shipping.`}</p>
    </div>
    <div class="shot">
      <img class="ph" src="/images/angle.webp" alt="White Blue Hour dispenser with clear pouches of capsules rising from the top" width="1122" height="1402" fetchpriority="high">
      <div class="spin" aria-hidden="true">
        <svg viewBox="0 0 120 120"><defs><path id="circ" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0"/></defs><text><textPath href="#circ" textLength="284" lengthAdjust="spacing">{PREORDER ? 'PRE-ORDER * 30 NIGHTS * ' : '30 NIGHTS * ONE ROLL * '}</textPath></text></svg>
        <b>${FIRST}</b>
      </div>
      <button class="cap" data-float=".14" style="--tt:1.7s;--f:.14;--x:3%;--y:22%;--w:27%;--r:-38deg;--t:5.200s" aria-label="Spin capsule"><span><img src="/images/cap-steady.webp" alt="" width="900" height="340"></span></button>
      <button class="cap" data-float=".22" style="--tt:2.1s;--f:.22;--x:72%;--y:50%;--w:25%;--r:18deg;--t:4.300s" aria-label="Spin capsule"><span><img src="/images/cap-still.webp" alt="" width="900" height="340"></span></button>
      <button class="cap" data-float=".1" style="--tt:2.4s;--f:.1;--x:0%;--y:70%;--w:21%;--r:62deg;--t:6s" aria-label="Spin capsule"><span><img src="/images/cap-guard.webp" alt="" width="900" height="340"></span></button>
      <button class="cap" data-float=".18" style="--tt:2.7s;--f:.18;--x:73%;--y:82%;--w:24%;--r:-24deg;--t:4.800s" aria-label="Spin capsule"><span><img src="/images/cap-bright.webp" alt="" width="900" height="340"></span></button>
    </div>
  </header>
  <Marquee />

  <section class="sec why">
    <div class="w stack rv">
      <p class="def"><b>blue hour</b> <span>noun</span></p>
      <h2>The deep blue light right before sunrise, when the night is over and the day hasn't started yet.</h2>
      <p>If you've walked out of a club or a festival into it, you know the feeling. We named the brand after that moment and made it for the day that comes after.</p>
    </div>
  </section>

  <section class="sec band-mist">
    <div class="w two">
      <div class="stack rv">
        <h2>Six capsules.<br>One pouch.<br>Zero thinking.</h2>
        <p>No lining up five bottles at 4am. Everything is sealed in one pouch, so you tear it off, take it with a snack and some water, and go to sleep. Take our signature six or build your own.</p>
        <a class="btn" href="/shop#build">Build your pouch</a>
      </div>
      <div class="rv" style="position:relative"><img src="/images/hand.webp" alt="A hand holding one frosted Blue Hour pouch against a blue sky" width="1122" height="1402" loading="lazy" style="border-radius:24px;box-shadow:0 26px 60px rgba(11,31,158,.28)"></div>
    </div>
  </section>

  <section class="sec dark slant">
    <div class="w stack" style="gap:34px">
      <p class="lead rv">Your body put in a shift tonight. Every capsule has a job, and together they help support:</p>
      <ol class="glist rv">
        <li><i>1</i><b>Energy production*</b></li>
        <li style="--dl:-1.200s"><i>2</i><b>Immune function*</b></li>
        <li style="--dl:-2.400s"><i>3</i><b>Muscle function*</b></li>
        <li style="--dl:-3.600s"><i>4</i><b>Nerve function*</b></li>
        <li style="--dl:-4.800s"><i>5</i><b>Antioxidant defense*</b></li>
      </ol>
      <a class="btn" href="/shop#build">See the menu</a>
    </div>
  </section>

  <section class="sec sky">
    <img class="burst" src="/images/burst.webp" alt="" loading="lazy" width="1100" height="820">
    <div class="grain"></div>
    <div class="w stack rv">
      <h2>Nothing extra<br>in the pouch.</h2>
      <p style="font-size:clamp(19px,5vw,23px);line-height:1.28;font-weight:600">Five ingredients, every dose on the label, and nothing that keeps you up.</p>
      <div class="chips"><span>No <span class="nw">5-HTP</span></span><span>No caffeine</span><span>No stimulants</span></div>
      <a class="btn" href="/shop#ingredients">See what's inside</a>
    </div>
  </section>

  <section class="sec nights" id="nights">
    <div class="w two">
      <div class="stack" style="gap:18px">
        <div class="ncount"><span class="thin">Night</span> <span id="ncount">30</span></div>
        <div class="ngrid" id="ngrid" aria-hidden="true"></div>
        <p style="font-weight:600">30 pouches on one roll, from the first night to the last.</p>
      </div>
      <div class="stack rv" style="gap:28px">
        <h2>Pull. Tear.<br>Sleep.</h2>
        <ol class="steps">
          <li>Pull one pouch from the dispenser.</li>
          <li>Tear it off along the perforated line.</li>
          <li>Take it with a late snack and a big glass of water, then lights out.</li>
        </ol>
        <p style="font-size:16px;opacity:.88">Hot room, long set, long run? Drink water through the day too. The pouch doesn't replace it.</p>
        <a class="btn" href="/shop">Get the roll</a>
      </div>
    </div>
  </section>

  <div class="fullshot cropd"><img class="ph" src="/images/exploded.webp" alt="The Blue Hour dispenser, pulp tray and roll of pouches floating on a blue background" loading="lazy" width="1122" height="1402"></div>

  <section class="sec pricey">
    <div class="w stack rv">
      <div class="bign">{perNight(FIRST)}</div>
      <h2 style="max-width:13em">a night. Less than a bottle of water at the club.</h2>
      <p class="crewline">Or {perNight(TIERS[2].each)} a night when you order 3 rolls with your crew.{PREORDER && ` Founding prices, for pre-orders shipping by ${SHIP_BY}.`}</p>
      <a class="btn solid" href="/shop">{PREORDER ? 'Pre-order 30 nights' : 'Buy 30 nights'}</a>
    </div>
  </section>
  <Foot id="em-home" />
</Base>
