---
import Base from '../layouts/Base.astro';
import Top from '../components/Top.astro';
import Promo from '../components/Promo.astro';
import Marquee from '../components/Marquee.astro';
import Seals from '../components/Seals.astro';
import Foot from '../components/Foot.astro';
import { reviews } from '../data/reviews';
import { INGREDIENTS, MAX_CAPS, SIGNATURE, mixSummary, TIERS, PRICE, perNight, refEachFor } from '../data/ingredients.js';
import { PREORDER, SHIP_BY } from '../data/preorder.js';
const FIRST = TIERS[0].each;
const BUY = PREORDER ? 'Pre-order now' : 'Buy now';
const signatureSummary = mixSummary(SIGNATURE);
// Gallery: product shots mixed with slides that sell (what's in a pouch, how a night works, what it costs).
// The receipt slide shows founding prices, so swap it out at launch.
const SLIDES = [
  { img: 'angle', w: 1122, h: 1402, alt: 'Blue Hour dispenser with pouches rising from the top' },
  { img: 'gal-callouts', w: 1080, h: 1350, alt: 'The dispenser with labels: tear one off a night, 6 capsules sealed, 30 nights on one roll' },
  { img: 'hand', w: 1122, h: 1402, alt: 'A hand holding one Blue Hour pouch, about the size of a palm' },
  { img: 'gal-steps', w: 1080, h: 1350, alt: 'How it works: pull one pouch, tear it off, take it with a snack and water, lights out' },
  { img: 'gal-six', w: 1080, h: 1350, alt: 'One pouch of six capsules: Level x2, Bright, Spark, Core, Glow, or build your own' },
  ...(PREORDER ? [{ img: 'gal-receipt', w: 1080, h: 1350, alt: 'A night out receipt where the Blue Hour pouch, $3.30, is the cheapest line' }] : []),
  { img: 'exploded', w: 1122, h: 1402, alt: 'Dispenser, tray and roll of pouches floating apart' },
  { img: 'flat', w: 1122, h: 1402, alt: 'Pouch ribbon curving out of the Blue Hour dispenser' },
];
const site = Astro.site!;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Blue Hour nightly pouches',
  description: 'One sealed pouch of 6 capsules a day: magnesium, vitamin C, methyl B-complex, zinc and glycine, or build your own. 30 pouches on one roll. No 5-HTP, caffeine or stimulants.',
  image: ['angle', 'flat', 'exploded', 'pouch'].map((n) => new URL(`/images/${n}.webp`, site).href),
  brand: { '@type': 'Brand', name: 'Blue Hour' },
  offers: {
    '@type': 'Offer',
    price: FIRST.toFixed(2),
    priceCurrency: 'USD',
    url: new URL('/shop', site).href,
    availability: PREORDER ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: 'Blue Hour' },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
    },
  },
};
---
<Base
  title="Blue Hour Nightly Pouches, 30 Nights | Blue Hour"
  description={`${PREORDER ? `Pre-order now: 30 sealed pouches on one roll for a $${FIRST} founding price (launch price $${PRICE}), shipping by ${SHIP_BY}.` : `30 sealed pouches on one roll for $${PRICE} with free US shipping.`} Build your own pouch or take the Signature Six.`}
  jsonld={jsonld}
>

  <Promo text="Free US shipping on every roll. No subscription." />
  <section class="phero">
    <div class="grain"></div>
    <Top />
    <div class="pgrid">
      <div class="gal" data-gal>
        <div class="gview">
          <div class="track" tabindex="0" aria-label={`Product photos, ${SLIDES.length} in total. Swipe or use the arrows to see more.`}>
            {SLIDES.map((sl, i) => <figure><img src={`/images/${sl.img}.webp`} alt={sl.alt} width={sl.w} height={sl.h} loading={i ? 'lazy' : 'eager'} fetchpriority={i ? 'auto' : 'high'}></figure>)}
          </div>
          <span class="gcount" aria-hidden="true"><b data-gcur>1</b> / {SLIDES.length}</span>
          <button class="garr prev" type="button" data-gprev aria-label="Previous photo"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button class="garr next" type="button" data-gnext aria-label="Next photo"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
        <div class="thumbs">
          {SLIDES.map((sl, i) => <button type="button" data-gto={i} aria-label={`Show photo ${i + 1}: ${sl.alt}`} aria-current={i === 0 ? 'true' : undefined}><img src={`/images/${sl.img}-t.webp`} alt="" width="160" height="200" loading="lazy"></button>)}
        </div>
      </div>
      <div class="buy" id="buybox">
        <h1>Blue Hour nightly pouches</h1>
        <p class="pricehead"><b>${FIRST}</b>{FIRST < PRICE && <s>${PRICE}</s>}<span>30 nights, {perNight(FIRST)} a night{PREORDER ? `. Ships by ${SHIP_BY}` : ''}</span></p>
        <ul class="perks">
          <li><span>One sealed pouch of 6 capsules a night</span></li>
          <li><span>No caffeine, stimulants or <span class="nw">5-HTP</span></span></li>
          <li><span>Take our signature six or pick your own</span></li>
          <li><span>Free US shipping, no subscription</span></li>
        </ul>
        <Seals prefix="s" labHref="#tested" />
        {PREORDER && <div class="pre"><b>Pre-order · ships by {SHIP_BY}</b><span>Founding price on our first run. We charge you today, and if you change your mind any time before your roll ships, you get a full refund.</span></div>}
        <p class="tag">One pouch. One night.</p>
        <p>For people who dance till close, train hard and still show up. Our signature pouch holds 6 capsules with magnesium, vitamin C, B-complex, zinc and glycine, or you can build your own. Every pouch is sealed and ready on one 30-night roll.*</p>
        <div class="mix"><b>Your pouch</b><span id="mixsum">Signature six: {signatureSummary}</span><a href="#build">Build your own pouch</a></div>
        <fieldset class="tiers">
          <legend>How many rolls?</legend>
          {TIERS.map((t, i) => (
            <label class="tier">
              <input type="radio" name="rolls" value={t.rolls} checked={i === 0} data-qty />
              <span class="tn"><b>{t.rolls} roll{t.rolls > 1 ? 's' : ''}{t.name && <em>{t.name}</em>}</b><small>{t.rolls * 30} nights · {perNight(t.each)} a night</small></span>
              <span class="tp"><b>${t.rolls * t.each}</b>{t.each < refEachFor(t.rolls) && <s>${t.rolls * refEachFor(t.rolls)}</s>}</span>
              {t.each < refEachFor(t.rolls) && <span class="save">Save ${t.rolls * (refEachFor(t.rolls) - t.each)}</span>}
            </label>
          ))}
        </fieldset>
        {PREORDER && <p class="launchnote">Founding price for pre-orders only. At launch, one roll goes back to ${PRICE}.</p>}
        <p class="rollnote"><b>What's a roll?</b> Our 30 sealed pouches, wound on one strip inside the dispenser. Just the capsules on the label, nothing else.</p>
        <p class="crewnote">Ordering with friends? Every roll in your cart counts toward the price, even with different pouches. 3 or more rolls are ${TIERS[2].each} each.</p>
        <div class="row" id="buyrow">
          <button class="add ghost" data-add>Add to cart</button>
          <button class="add" data-buy>{BUY}</button>
        </div>
        <ul class="assure">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{PREORDER ? 'Full refund any time before it ships' : 'Replaced or refunded if anything arrives wrong'}</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7zM7 18a1.5 1.5 0 1 0 0-.01M17 18a1.5 1.5 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Free US shipping{PREORDER ? `, ships by ${SHIP_BY}` : ''}</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>One-time purchase, nothing recurring</li>
        </ul>
        <p class="paynote"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3M5.5 10h13a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-8A1.5 1.5 0 0 1 5.5 10Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>Secure Stripe checkout · Apple Pay · Google Pay</p>
        <div class="spec"><b>Suggested use</b><span>Take 1 pouch a day with food and water, like with supper or a late snack before bed.</span><strong class="maxone">Do not take more than 1 pouch a day.</strong></div>
        <div class="spec"><b>Free US shipping on every order.</b><span>US only for now. One-time purchase, no subscription.{PREORDER && ` Pre-orders ship by ${SHIP_BY}.`}</span></div>
      </div>
    </div>
  </section>

  <section class="sec state">
    <div class="w stack rv" style="gap:30px">
      <h2>A night of Blue Hour costs <span>less than a bottle of water</span> at the club.</h2>
      {reviews.length > 0 && (
        <div class="bubbles">
          {reviews.map((r) => (
            <div class="bub"><i>{r.name.charAt(0)}</i><div><b>{r.name}</b>{r.text}</div></div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="sec dark scen slant" data-car data-auto>
    <div class="w stack" style="gap:30px;align-items:stretch">
      <h2 style="text-align:center;font-size:clamp(34px,8.6vw,60px)">Made for big nights and long days</h2>
      <div class="track" tabindex="0" aria-label="Situations Blue Hour fits">
        <article class="scard"><svg viewBox="0 0 96 96"><use href="#i-alarm"/></svg><div><h3>Work at nine?</h3><p>Stay for the last track anyway. One pouch with a snack, alarm set, done.</p></div></article>
        <article class="scard"><svg viewBox="0 0 96 96"><use href="#i-tent"/></svg><div><h3>Festival weekend?</h3><p>Three days, one tent, no bag of bottles. Tear off a strip of pouches and go.</p></div></article>
        <article class="scard"><svg viewBox="0 0 96 96"><use href="#i-weights"/></svg><div><h3>Training hard?</h3><p>Long run, leg day or a two-hour class. Same pouch, with your evening meal.</p></div></article>
        <article class="scard"><svg viewBox="0 0 96 96"><use href="#i-group"/></svg><div><h3>Going with friends?</h3><p>Thirty pouches go a long way. Tear one off and hand it over.</p></div></article>
      </div>
      <div class="dots lt"></div>
    </div>
  </section>

  <section class="sec build" id="build">
    <div class="w">
      <div class="bhead">
        <h2>Build your pouch.</h2>
        <p>Start with our signature six or swap in what you want. Pick up to {MAX_CAPS} capsules. Some have a per-pouch limit, so one pouch never stacks up too much of one nutrient. Every roll is packed to order, and the price stays the same.</p>
      </div>
      <div class="tray" aria-live="polite">
        <div class="slots" id="slots">{Array.from({ length: MAX_CAPS }, () => <i></i>)}</div>
        <div class="tally"><b id="tally">{MAX_CAPS} of {MAX_CAPS}</b><button type="button" id="reset">Back to signature</button></div>
      </div>
      <div class="ilist">
        {INGREDIENTS.map((i) => (
          <article class:list={['icard', { on: i.signature > 0 }]} data-id={i.id} data-max={i.max}>
            <img src={`/images/${i.img}.webp`} alt="" width="900" height="340" loading="lazy" />
            <div class="it">
              <h3>{i.name}{i.signature > 0 && <span class="sig">Signature</span>}</h3>
              <div class="ing">{i.ingredient}{i.dose && ` · ${i.dose}`}</div>
              <div class="lim">Up to {i.max} per pouch</div>
              <p>{i.blurb}</p>
            </div>
            <div class="step">
              <button type="button" data-inc aria-label={`Add ${i.name}`}>+</button>
              <span data-n>{i.signature}</span>
              <button type="button" data-dec aria-label={`Remove ${i.name}`}>&minus;</button>
            </div>
            {i.facts && (
              <details class="facts">
                <summary>Supplement Facts, per capsule</summary>
                <div class="factwrap">
                  <table>
                    <thead><tr><th scope="col">Nutrient</th><th scope="col">Amount</th><th scope="col">% DV</th></tr></thead>
                    <tbody>{i.facts.map(([n, a, dv]) => <tr><td>{n}</td><td>{a}</td><td>{dv}</td></tr>)}</tbody>
                  </table>
                </div>
                {i.facts.some((f) => f[2] === '\u2020') && <p class="other">&dagger; Daily Value not established.</p>}
                {i.other && <p class="other">Other ingredients: {i.other}</p>}
                {i.warn && <p class="other">Warnings: {i.warn}</p>}
                {i.coa
                  ? <div class="coa"><b>Lab tested by {i.coa.lab}, {i.coa.date}</b><span>{i.coa.found && `Found ${i.coa.found}. `}{i.coa.metals && `${i.coa.metals} `}{i.coa.micro}</span>{(i.coa.files || [['Open the full lab report (PDF)', i.coa.file]]).map(([label, href]) => <a href={href} target="_blank" rel="noopener">{label}</a>)}</div>
                  : <p class="other">Lab report for this capsule coming soon.</p>}
              </details>
            )}
          </article>
        ))}
      </div>
      <div class="bfoot">
        <div class="leftout"><b>Not on the menu:</b> <span class="nw">5-HTP</span>, caffeine and stimulants.</div>
        <button class="btn solid" data-add>Add this pouch, <span data-price-short>${FIRST}</span></button>
        <p class="fine">Talk to a doctor or pharmacist before adding anything new if you take medication, have a medical condition, or are pregnant or nursing. Capsules shown are illustrations. Your exact pouch is listed on the Supplement Facts in your pamphlet.</p>
      </div>
    </div>
  </section>

  <Marquee />

  <section class="sec worth">
    <div class="w stack" style="gap:42px;align-items:stretch">
      <h2 class="rv" style="max-width:12em">The cheapest part of your night out.</h2>
      <div class="wgrid">
        <article class="us"><div class="ic"><img src="/images/pouch.webp" alt="" loading="lazy" width="1122" height="1402"></div><b>{perNight(FIRST)}</b><span>One night of Blue Hour</span></article>
        <article><div class="ic"><svg viewBox="0 0 96 96"><use href="#i-cocktail"/></svg></div><b>$16</b><span>One cocktail</span></article>
        <article><div class="ic"><svg viewBox="0 0 96 96"><use href="#i-car"/></svg></div><b>$28</b><span>Ride home</span></article>
        <article><div class="ic"><svg viewBox="0 0 96 96"><use href="#i-slice"/></svg></div><b>$14</b><span>Late-night food</span></article>
        <article><div class="ic"><svg viewBox="0 0 96 96"><use href="#i-ticket"/></svg></div><b>$40</b><span>Club entry</span></article>
        <article><div class="ic"><svg viewBox="0 0 96 96"><use href="#i-water"/></svg></div><b>$12</b><span>Two venue waters</span></article>
      </div>
      <p class="fine" style="text-align:center;max-width:none">Example US prices for comparison. Yours will vary by city and venue.</p>
    </div>
  </section>

  <section class="sec">
    <div class="w stack" style="gap:30px;align-items:stretch">
      <h2 class="rv">Not your usual night-out supplement.</h2>
      <div class="tbw rv"><table class="tb">
        <thead><tr><th></th><th class="us">Blue Hour</th><th>Typical night-out supplement</th></tr></thead>
        <tbody>
          <tr><td><span class="nw">5-HTP</span></td><td class="us">None</td><td>Often included</td></tr>
          <tr><td>Caffeine or stimulants</td><td class="us">None</td><td>Varies</td></tr>
          <tr><td>Choose your capsules</td><td class="us">Yes, up to 6 from a menu of 8</td><td>One fixed formula</td></tr>
          <tr><td>Format</td><td class="us">One dispenser, 30 sealed pouches</td><td>Bottles or loose packs</td></tr>
          <tr><td>Lab reports</td><td class="us">Public for every capsule</td><td>Often on request, if at all</td></tr>
          <tr><td>Subscription</td><td class="us">None</td><td>Often the default</td></tr>
          <tr><td>What we promise</td><td class="us">Support, never a cure</td><td>Often big claims</td></tr>
        </tbody>
      </table></div>
      <p class="fine">Based on common products in the category. Individual brands differ.</p>
    </div>
  </section>

  <section class="sec dark slant">
    <div class="w"><div class="tgrid">
      <article class="rv"><svg viewBox="0 0 96 96"><use href="#i-roll"/></svg>30 single-serve pouches on one roll</article>
      <article class="rv"><svg viewBox="0 0 96 96"><use href="#i-ban"/></svg><span>No <span class="nw">5-HTP</span>, no caffeine and no stimulants</span></article>
      <article class="rv"><svg viewBox="0 0 96 96"><use href="#i-list"/></svg>Every ingredient listed on the label</article>
      <article class="rv"><svg viewBox="0 0 96 96"><use href="#i-truck"/></svg>Free shipping anywhere in the US</article>
      <article class="rv"><svg viewBox="0 0 96 96"><use href="#i-free"/></svg>One-time purchase with no subscription</article>
      <article class="rv"><svg viewBox="0 0 96 96"><use href="#i-spark"/></svg>Support for your routine, never a cure</article>
    </div></div>
  </section>

  <section class="sec" id="ingredients">
    <div class="w">
      <h2 class="rv" style="color:var(--deep)">Ingredients</h2>
      <p class="sub-h rv" style="margin-top:14px">Five things, and we'll tell you why each one is there.</p>
      <div class="ingr">
        <article><h3>Magnesium</h3><p>A mineral your body uses for normal muscle and nerve function. Two capsules of magnesium glycinate give you 266 mg.*</p><img src="/images/powder-still.webp" alt="" loading="lazy" width="1300" height="560"></article>
        <article><h3>Vitamin C</h3><p>An antioxidant nutrient that helps protect cells and supports normal immune function. Each capsule has 1,000 mg.*</p><img src="/images/powder-bright.webp" alt="" loading="lazy" width="1300" height="560"></article>
        <article><h3>Methyl B-complex</h3><p>Eight B vitamins that help your body turn food into energy: B1, B2, B3, B5, B6, biotin, folate as 5-MTHF, and B12 as methylcobalamin.*</p><img src="/images/powder-steady.webp" alt="" loading="lazy" width="1300" height="560"></article>
        <article><h3>Zinc</h3><p>An essential mineral that helps support normal immune function. Each capsule has 25 mg.*</p><img src="/images/powder-guard.webp" alt="" loading="lazy" width="1300" height="560"></article>
        <article><h3>Glycine</h3><p>The simplest amino acid. Your body uses it to build proteins, including collagen. Each capsule has 850 mg.*</p><img src="/images/powder-hush.webp" alt="" loading="lazy" width="1300" height="560"></article>
        <article class="out"><h3>What we left out</h3><p><span class="nw">5-HTP</span>, caffeine and stimulants. Five ingredients is the whole list.</p></article>
      </div>
    </div>
  </section>

  <section class="sec tested" id="tested">
    <div class="w">
      <h2 class="rv" style="color:var(--deep)">Checked by outside labs.</h2>
      <p class="sub-h rv" style="margin-top:14px">Independent labs tested every capsule on our menu. Each one tested for strength came back at or above what the label says.</p>
      <ul class="labs">
        {INGREDIENTS.filter((i) => i.coa).map((i) => (
          <li>
            <div class="lname"><b>{i.name}</b><span>{i.ingredient}</span></div>
            {i.coa.got
              ? <div class="lgot"><b>{i.coa.got}</b><span>{i.coa.gotUnit ? `${i.coa.gotUnit}, ` : ''}label says {i.coa.label}</span></div>
              : <div class="lgot"><b>None</b><span>heavy metals detected</span></div>}
            <p class="lchk">{i.coa.metals ? 'Tested for arsenic, cadmium, lead and mercury. ' : ''}No E. coli, Salmonella or Staph.</p>
            <p class="lby">{i.coa.lab}, {i.coa.date}{(i.coa.files || [['Report (PDF)', i.coa.file]]).map(([label, href]) => <a href={href} target="_blank" rel="noopener">{label.replace(' report', '')}</a>)}</p>
          </li>
        ))}
      </ul>
      <p class="fine">Reports come from Eurofins, Intertek and New Wave Scientific, and cover the batch tested on the date shown. Our manufacturing partner tests ingredients as they arrive. Open any PDF to see the full report.</p>
    </div>
  </section>

  <section class="sec sky tagband">
    <div class="grain"></div>
    <div class="w">
      <h2>Dance till close.<br>Show up anyway.</h2>
      <button class="btn" data-buy>{BUY}, <span data-price-short>${FIRST}</span></button>
    </div>
  </section>

  <section class="sec faq" id="faq" style="background:#FAFBFF">
    <div class="w">
      <h2 style="color:var(--deep);margin-bottom:18px">FAQs</h2>
      {PREORDER && <>
        <details><summary><span class="q">When will my roll ship?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Pre-orders ship by {SHIP_BY}, free within the US. Delivery usually takes 3 to 8 business days after that, and we'll email you tracking when it ships.</p></details>
        <details><summary><span class="q">When am I charged?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Today, at the founding price. That price is only for pre-orders. At launch, one roll goes back to ${PRICE}.</p></details>
        <details><summary><span class="q">Can I cancel my pre-order?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Yes. Any time before your roll ships, email <a href="mailto:hello@bluehournights.com">hello@bluehournights.com</a> with your order number and we'll refund you in full, with no questions. If we ever can't ship by {SHIP_BY}, we'll email you before then with a new date, and you can cancel for a full refund.</p></details>
      </>}
      <details><summary><span class="q">Is Blue Hour third-party tested?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Yes. Independent labs (Eurofins, Intertek and New Wave Scientific) tested every capsule on our menu for strength or contaminants, and you can open every full report on this page. Each capsule tested for strength came back at or above its label. These are lab tests, not a certification like NSF or USP.</p></details>
      <details><summary><span class="q">Is there a smaller size than 30 nights?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Not yet. Every roll is packed to order, pouch by pouch, and most of the cost is the packing, not the capsules, so a 10-night roll would cost nearly as much as 30. Bigger runs bring that cost down, and smaller rolls like a weekend or festival pack are next once we get there. Until then, a roll isn't 30 nights in a row, it's one pouch for every night out. You can also split one with a friend.</p></details>
      <details><summary><span class="q">Where is Blue Hour made?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Every roll is packed to order by our manufacturing partner in Reno, Nevada, in a facility that's independently certified for current Good Manufacturing Practices (cGMP). Ingredients are tested by independent labs, and the Supplement Facts for every capsule are on this page and on the pamphlet in your box.</p></details>
      <details><summary><span class="q">What do you mean by a roll?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>A roll is how our pouches come: 30 sealed pouches on one perforated strip, wound up inside the dispenser. When we say a roll, a crew roll or 3 rolls, that's all we mean. Every roll holds only the dietary supplements listed on your label and pamphlet, and nothing else.</p></details>
      <details><summary><span class="q">Does Blue Hour contain <span class="nw">5-HTP</span>?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. We left out 5-HTP, L-tryptophan, St John's wort and anything else that raises serotonin. There's also no caffeine, no stimulants and no melatonin.</p></details>
      <details><summary><span class="q">How and when do I take it?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Pull one pouch from the dispenser, tear it off along the perforated line, and take the capsules with food and water, like with supper or a late snack before bed. Take 1 pouch a day, and never more than 1. Always follow the directions on your pamphlet.</p></details>
      <details><summary><span class="q">Does it cure anything?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. Blue Hour is a dietary supplement. It isn't intended to diagnose, treat, cure or prevent any disease, and it doesn't make alcohol or anything else you take safer. Water, food and sleep still do the heavy lifting.</p></details>
      <details><summary><span class="q">Is it only for nights out?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. It's for any day that asks a lot of you: a long set, a festival weekend, a hard training session or a double shift. Take 1 pouch a day with food.</p></details>
      {PREORDER
        ? <details><summary><span class="q">Why does it cost what it does?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>You get 30 sealed single-serve pouches, the dispenser and free US shipping. At the founding price, one roll is ${TIERS[0].each}, or {perNight(TIERS[0].each)} a night. Order 2 rolls and each is ${TIERS[1].each}. Order 3 or more and each is ${TIERS[2].each}, which is {perNight(TIERS[2].each)} a night. At launch, one roll will be ${PRICE}.</p></details>
        : <details><summary><span class="q">Why does it cost what it does?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>You get 30 sealed single-serve pouches, the dispenser and free US shipping. One roll works out at $4.30 a night. Order 2 rolls and each is $119. Order 3 or more and each is $109, which is $3.63 a night. Rolls with different pouches count together, so you can order with friends.</p></details>}
      <details><summary><span class="q">Can I change what's in my pouch?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Yes. Start from the signature six or build your own from our menu of 8 capsules, up to 6 per pouch. Every roll is packed to order, and your pamphlet lists exactly what's in it.</p></details>
      <details><summary><span class="q">What if something's wrong with my order?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Tell us within 5 business days of delivery and we'll send a replacement or a refund. Rolls are packed to order, so we can't take returns for change of mind. See <a href="/refunds">Refunds and replacements</a>.</p></details>
      {PREORDER
        ? <details><summary><span class="q">Do you have discount codes?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Not during pre-order. The founding price is already our best deal, so codes and hidden discounts are paused until launch. Crew pricing still applies when you order more than one roll. The one exception is a Founding Crew code from one of our ambassadors, which takes $5 off each roll.</p></details>
        : <details><summary><span class="q">Do you have discount codes?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>New visitors can get 10% off their first roll through the welcome pop-up. The offer only lasts while the pop-up is open, and once it's closed it won't come back on that browser for 24 hours. If you came from a link with a code, it's saved and comes off at checkout automatically. You can also type a code on the payment page. And a few discounts are hidden around this site, if you look closely. Only one discount applies per order, and we always use the one that saves you the most.</p></details>}
      <details><summary><span class="q">Is this a subscription?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>No. You buy a roll when you want one, and nothing renews.</p></details>
      <details><summary><span class="q">Can I take Blue Hour with medication?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>Most people can, but ask a pharmacist first if you take seizure medication, blood thinners, heart or blood pressure medication (including nitrates or nitrites), antibiotics, ADHD medication, antidepressants or other psychiatric medication, or methotrexate. Take antibiotics at least 2 hours apart from your pouch. If your immune system is weakened, talk to your doctor before taking the probiotic.</p></details>
      <details><summary><span class="q">Is it right for me?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>For adults only. Keep out of reach of children. If you are pregnant, nursing, taking medication, have a medical condition, or are under medical supervision, talk to your doctor before use. Stop taking it and talk to your doctor if you have any side effects.</p></details>
      <details><summary><span class="q">Do you ship to my country?</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></summary><p>We ship within the US for now.</p></details>
    </div>
  </section>
  <Foot id="em-shop" />
  <div class="stick" id="stick">
    <div class="in">
      <div class="row">
        <label class="sel"><span class="pr" data-price>${FIRST}.00</span><span class="op"><span data-rolls>1 roll</span><svg viewBox="0 0 24 24"><use href="#i-chev"/></svg></span>
          <select id="sel-stick" data-qty aria-label="How many rolls">{TIERS.map((t) => <option value={t.rolls}>{t.rolls} roll{t.rolls > 1 ? 's' : ''}, ${t.rolls * t.each}{t.each < refEachFor(t.rolls) ? `, save $${t.rolls * (refEachFor(t.rolls) - t.each)}` : ''}</option>)}</select></label>
        <button class="add" data-buy>{BUY}</button>
      </div>
      <p class="caps-note">Free US shipping. 3+ rolls ${TIERS[2].each} each.</p>
    </div>
  </div>
</Base>
