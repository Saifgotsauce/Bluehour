    .ifstate a{color:var(--cobalt)}
    html[data-state="proof_seeker"] .ifstate[data-for~="proof_seeker"],
    html[data-state="price_evaluator"] .ifstate[data-for~="price_evaluator"],
    html[data-state="cart_holder"] .ifstate[data-for~="cart_holder"]{display:block}
    .rollnote a{color:var(--cobalt);font-weight:600;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
    .why30{background:var(--mist);scroll-margin-top:12px}
    .why30in{display:grid;gap:clamp(18px,4vw,40px)}
    .why30 h2{color:var(--deep);font-size:clamp(32px,8.4vw,58px);line-height:1.02;letter-spacing:-.04em;max-width:10em;margin:0}
    .why30txt{display:grid;gap:14px;max-width:36em}
    .why30txt p{margin:0;font-size:clamp(16px,4.2vw,19px);line-height:1.5;color:var(--soft)}
    .why30txt .lead{font:700 clamp(19px,5vw,24px)/1.35 var(--display);letter-spacing:-.015em;color:var(--ink)}
    .why30txt .sign{color:var(--ink);font-weight:600}
    @media (min-width:900px){.why30in{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:start}}
  </style>
