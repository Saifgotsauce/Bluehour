---
import { FOUNDING, DELIVERY, FOUNDING_CAP } from '../data/preorder.js';
import { TIERS, PRICE } from '../data/ingredients.js';
interface Props { text: string; link?: string; href?: string }
// While the founding offer runs, every page shows the same banner, so the offer and delivery time are always in view.
const { text, link, href } = Astro.props;
---
{FOUNDING
  ? <div class="promo">Founding price: <b>${TIERS[0].each}</b>{' '}<s>${PRICE}</s>{' '}a roll for the first {FOUNDING_CAP} orders. Arrives in {DELIVERY}.</div>
  : <div class="promo">{text} {link && href && <a href={href}>{link}</a>}</div>}
