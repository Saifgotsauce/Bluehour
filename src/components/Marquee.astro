---
const items = ["Out late. Up early.", "Monday doesn't care what time you got home.", "Dance till close. Show up anyway.", "One pouch. One night.", "See you at the next one."];
const loop = [...items, ...items, ...items, ...items];
---
<div class="mq" aria-hidden="true"><div>{loop.map((t) => (<><span>{t}</span><em>*</em></>))}</div></div>
