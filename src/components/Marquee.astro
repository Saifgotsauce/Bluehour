---
const items = ["Last track. First light.", "Stay late. Show up anyway.", "Dance floor to desk.", "See you at the next one.", "One pouch. One night."];
const loop = [...items, ...items, ...items, ...items];
---
<div class="mq" aria-hidden="true"><div>{loop.map((t) => (<><span>{t}</span><em>*</em></>))}</div></div>
